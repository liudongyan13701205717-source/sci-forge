: str, +    *, +    paper_id: str, +    layout: Layout, +    limit: int = 10, +    sources: list[str] | None = None, +) -> LiteratureReview: +    r = LiteratureReview(ok=False, topic=topic) +    notes: list = [] +    from clawsgo_self.science.api import cross_lookup +    if sources: +        papers = cross_lookup(topic, databases=sources, limit=limit) +    else: +        papers = lit.search_openalex(topic, limit=limit) +    papers = lit.dedupe(papers) +    r.papers = papers +    if not papers: +        notes.append("OpenAlex 妫€绱㈡棤缁撴灉锛堢绾挎垨缃戠粶锛夛紝缁艰堪鍩轰簬绌洪泦锛岀己鍙ｄ负鍚彂寮忋€?) +    r.keyworks = _keywords(topic) + +    if llm.configured() and papers: +        try: +            _llm_review(r, notes) +            r.llm_used = True +        except RuntimeError as e: +            notes.append(f"LLM 缁艰堪涓嶅彲鐢紝鍥為€€妯℃澘锛歿e}") + +    if not r.clusters: +        _template_review(r, notes) + +    r.notes = notes +    r.ok = True +    _persist(layout, paper_id, r) +    return r + + +def _keywords(topic: str) -> list: +    # 绠€鍗曞垎璇嶏細鎸夌┖鏍?閫楀彿/椤垮彿鎷嗗垎锛屽幓閲嶅苟淇濈暀鍓?6 涓?+    import re + +    toks = re.split(r"[\s,锛屻€?锛?]+", topic) +    out = [] +    for t in toks: +        t = t.strip() +        if t and t not in out: +            out.append(t) +    return out[:6] or [topic] + + +def _template_review(r: LiteratureReview, notes: list) -> None: +    papers = r.papers +    # 鎸夊勾浠芥帓搴忥紝褰㈡垚鏃堕棿绾垮紡鑱氱被 +    years = sorted({(p.get("year") or 0) for p in papers}) +    r.clusters = [f"杩戝勾鍦ㄣ€寋r.topic}銆嶇殑浠ｈ〃杩涘睍锛堟椂闂寸嚎 {y} 鍓嶅悗锛? for y in years[-3:]] or [ +        "灏氭棤寮虹浉鍏虫枃鐚紝灞炴棭鏈熼樁娈?] +    r.gaps = [ +        "鐜版湁宸ヤ綔鏅亶缂哄皯璺ㄩ鍩?澶ц妯℃硾鍖栭獙璇?, +        "缁熶竴鍩哄噯涓庡叕骞冲姣斾笉瓒筹紙鎸囨爣鍙ｅ緞涓嶄竴锛?, +        "寰堝皯閽堝璧勬簮鍙楅檺鍦烘櫙鍋氭晥鐜?绮惧害鑱斿悎浼樺寲", +    ] +    r.outline = [ +        "寮曡█锛氬姩鏈轰笌缁艰堪鑼冨洿", +        "鐩稿叧鏂规硶鍒嗙被涓庝唬琛ㄥ伐浣滅患杩?, +        "鏂规硶瀵规瘮琛紙鏂规硶/鏁版嵁/鎸囨爣/缁撴灉锛?, +        "鐮旂┒缂哄彛涓庢湰宸ヤ綔瀹氫綅", +        "灏忕粨涓庡睍鏈?, +    ] +    if not papers: +        notes.append("妯℃澘缁艰堪锛氭湭鑳芥绱㈠埌瀹為檯鏂囩尞锛屽唴瀹逛负鍗犱綅妗嗘灦銆?) +    else: +        notes.append("鏃?L