project_dir("p_mem") / "memory.json") +    assert md.exists() + + +def test_review_code_scans_py(tmp_path): +    from clawsgo_self.reproduce.codereview import review_code + +    lay = _layout(tmp_path) +    task = lay.task_dir("t_code") +    (task / "train.py").write_text( +        "import torch\n" +        "def train():\n" +        "    print('hi')\n" +        "    acc = 0.99  # magic\n" +        "    pass\n", +        encoding="utf-8", +    ) +    r = review_code(task_id="t_code", layout=lay) +    assert r.ok is True +    assert len(r.files) == 1 +    f = r.files[0] +    cats = {i["category"] for i in f["issues"]} +    assert "debug" in cats and "stub" in cats +    assert f["stats"]["has_backend"] is True +    assert r.scores["total"] is not None +    assert any(c["text"].startswith("鍚殢鏈虹瀛?) for c in r.checklist) +    assert (task / "code_review.md").exists() + + +def test_review_code_missing_task(tmp_path): +    from clawsgo_self.reproduce.codereview import review_code + +    lay = _layout(tmp_path) +    r = review_code(task_id="ghost", layout=lay) +    assert r.ok is False +    assert "涓嶅瓨鍦? in r.error \ No newline at end of file diff --git a/tests/test_research.py b/tests/test_research.py index 2ca6076..fc87986 100644 --- a/tests/test_research.py +++ b/tests/test_research.py @@ -152,10 +152,143 @@ def test_verdict_pivot_on_failure(tmp_path):      from clawsgo_self.research.api import decision_readout        layout = _layout(tmp_path)      tid = "tf"      task_root = layout.task_dir(tid)      task_root.joinpath("results.json").write_text(          json.dumps({"ok": False, "error": "鑷剤閲嶈瘯澶辫触"}), encoding="utf-8"      )      v = decision_readout(task_id=tid, layout=layout)      assert v["verdict"] == "PIVOT" + + +# ---- 鏂板绉戠爺/璁烘枃鍏伐鍏?---- + +def _write_doc(layout: Layout, paper_id: str, text: str) -> None: +    store = DocStore(layout, paper_id) +    store.sections_dir.mkdir(parents=True, exist_ok=True) +    store.write_section("introduction", text, fmt="markd