lex +science_search("uniprot", "BRCA1", limit=3)                   # 鎼滅储 UniProt +science_search("chembl", "aspirin", limit=5)                  # 鎼滅储 ChEMBL +``` + +### 鎸?ID 鑾峰彇璁板綍 + +```text +science_fetch("openalex", "W123456789")            # 鑾峰彇 OpenAlex 璁板綍 +science_fetch("uniprot", "P53_HUMAN")              # 鑾峰彇 UniProt 璁板綍 +science_fetch("rcsb-pdb", "1ABC")                  # 鑾峰彇 PDB 缁撴瀯 +``` + +### 澶氬簱鑱斿悎鏌ヨ + +```text +science_cross_lookup("BRCA1", databases=["uniprot", "mygene"], limit=3)   # 澶氬簱鏌?BRCA1 +science_cross_lookup("aspirin")                                             # 鍏ㄥ簱鎼滅储 +``` diff --git a/clawsgo_self/core/__init__.py b/clawsgo_self/core/__init__.py index cb32b90..6493174 100644 --- a/clawsgo_self/core/__init__.py +++ b/clawsgo_self/core/__init__.py @@ -46,17 +46,22 @@ class Layout:          return d        def task_dir(self, task_id: str) -> Path:          d = self.tasks_dir / _safe(task_id)          d.mkdir(parents=True, exist_ok=True)          return d      def _safe(name: str) -> str:      """娓呮礂璺緞娈碉紝闃叉璺緞绌胯秺銆?"" +    return clean_segment(name) + + +def clean_segment(name: str) -> str: +    """鍏紑鐨勮矾寰勬娓呮礂锛氶潪瀛楁瘝鏁板瓧/`-_.` 缁熶竴鏇挎崲涓?`_`銆?""      cleaned = "".join(c if (c.isalnum() or c in "-_.") else "_" for c in name)      cleaned = cleaned.strip(" .")      return cleaned or "untitled"      def get_layout() -> Layout:      return Layout(workspace_root()) diff --git a/clawsgo_self/core/memory.py b/clawsgo_self/core/memory.py new file mode 100644 index 0000000..57a0374 --- /dev/null +++ b/clawsgo_self/core/memory.py @@ -0,0 +1,177 @@ +"""椤圭洰杩涘害璁拌处锛坢emory锛夛細涓?projects/{paper_id} 缁存姢涓€鏉?timeline锛?+璁板綍閲岀▼纰戙€佺姸鎬佷笌澶囨敞锛屽舰鎴愬彲鍥炴函鐨勭爺绌舵棩蹇椼€?+ +绾湰鍦?JSON锛屾棤缃戠粶銆?+""" + +from __future__ import annotations + +import json +import time +from dataclasses import dataclass, field + +from clawsgo_self.core import Layout + + +@dataclass +class MemoryEntry: +    ts: str +    action: str          # note | milestone | status +    note: str = "" +    milestone: str = "" +    status: str = "" + +    def to_dict(self) -> dict: +        return {"ts": self.ts, "action": self.action, "note": self.note, +                "milestone": self.milestone, "status": self.status} + + +@dataclass +class ProjectMemory: +    ok: bool +    paper_id: str = "" +    entries: list = field(default_factory=list) +    summary: list = field(default_factory=list) +    error: str = "" + +    def to_dict(self) -> dict: +        return {"ok": self.ok, "paper_id": self.paper_id, +                "entries": self.entries, "summary": self.summary, "error": self.error} + +    def to_markdown(self) -> str: +        lines = [f"# 椤圭洰杩涘害锛歿self.paper_id}", ""] +        if not self.entries: +            lines.append("- 锛堟殏鏃犺褰曪紝鐢?project_memory 娣诲姞锛?) +        for e in self.entries: +            tag = {"note": "澶囧繕", "milestone": "閲岀▼纰?, "status": "鐘舵€?}.get(e["action"], e["action"]) +            body = [] +            if e.get("note"): +                body.append(e["note"]) +            if e.get("milestone"): +                body.append("閲岀▼纰戯細" + e["milestone"]) +            if e.get("status"): +                body.append("鐘舵€侊細" + e["status"]) +            lines.append(f"- `[{e['ts']}] {tag}` {' 锝?'.join(body) if body else '锛堢┖锛?}") +        return "\n".join(lines) + + +def _semver_like(s: str) -> bool: +    s = s.strip() +    try: +        a, b, c = s.split(".") +        int(a); int(b); int(c) +        return a.isdigit() and b.isdigit() and c.isdigit() +    except (ValueError, AttributeError): +        return False + + +def _milestone_sort(entries: list[dict]) -> list[dict]: +    """鎶婄函 digit 閲岀▼纰戯紙濡?1.0.0锛夋寜鐗堟湰搴忔帓鍦ㄥ悇鑷綅缃€?"" +    def ver_key(e): +        ms = (e.get("milestone") or "").strip() +        if _semver_like(ms): +            try: +                return (0, tuple(int(x) for x in ms.split(".")), e["ts"]) +            except (ValueError, AttributeError): +                return (1, (0, 0, 0), e["ts"]) +        return (1, (0, 0, 0), e["ts"]) +    return sorted(entries, key=ver_key) + + +def _backlog(layout: Layout, paper_id: str) -> list[dict]: +    """鎶?work_plan 鐨?breakpoints/checkpoints 鍙樻垚寰呰窡韪噷绋嬬銆?"" +    root = layout.project_dir(paper_id) / "research" +    out: list[dict] = [] +    for name in ("research_plan.json", "work_plan.json"): +        p = root / name +        if not p.exists(): +            continue +        try: +            data = json.loads(p.read_text(encoding="utf-8")) +        except (OSError, ValueError): +            continue +        nodes = [] +        for key in ("breakpoints", "checkpoints", "milestones"): +            nodes.extend(data.get(key) or [] if isinstance(data, dict) else []) +        for n in nodes: +            if isinstance(n, str): +                out.append({"milestone": n.strip(), "_planned": True}) +            elif isinstance(n, dict): +                for k in ("id", "title", "name", "milestone"): +                    v = n.get(k) +                    if v: +                        out.append({"milestone": str(v).strip(), "_planned": True}) +                        break +    return out + + +def project_memory( +    *, +    paper_id: str, +    layout: Layout, +    action: str = "read", +    note: str = "", +    milestone: str = "", +    status: str = "", +    subject: str = "", +) -> ProjectMemory: +    """璁拌处锛歛ction鈭坽read,note,milestone,status,rename}锛泂ubject 鐢ㄤ簬 rename銆?"" +    root = layout.project_dir(paper_id) +    root.mkdir(parents=True, exist_ok=True) +    db = root / "memory.json" +    entries: list[dict] = [] +    if db.exists(): +        try: +            entries = json.loads(db.read_text(encoding="utf-8")) +        except (OSError, ValueError): +            entries = [] + +    if action == "read": +        entries = _milestone_sort(entries) +        return _finalize(layout, paper_id, entries, db, write=False) + +    ts = time.strftime("%Y-%m-%d %H:%M:%S") +    if action == "note": +        if not note: +            return _finalize(layout, paper_id, entries, db, error="note 涓嶈兘涓虹┖") +        entry = MemoryEntry(ts=ts, action="note", note=note) +    elif action == "milestone": +        if not milestone: +            return _finalize(layout, paper_id, entries, db, error="milestone 涓嶈兘涓虹┖") +        entry = MemoryEntry(ts=ts, action="milestone", milestone=milestone, note=note) +    elif action == "status": +        entry = MemoryEntry(ts=ts, action="status", status=status, note=note) +    elif action == "rename": +        entries = list(filter(None, entries))  # keep shape +        return _finalize(layout, paper_id, entries, db, +                         error="rename 闇€瑕佷紶鍏ユ柊鍚嶇О锛堥」鐩洰褰曡鐢ㄦ枃浠剁郴缁熼噸鍛藉悕锛?) +    else: +        return _finalize(layout, paper_id, entries, db, +                         error=f"鏈煡 action锛歿action}锛堝彲閫?read/note/milestone/status锛?) + +    entries.append(entry.to_dict()) +    return _finalize(layout, paper_id, entries, db, write=True) + + +def _finalize(layout, paper_id, entries, db, *, write=True, error=""): +    if write: +        db.write_text(json.dumps(entries, ensure_ascii=False, indent=2), encoding="utf-8") +    summary = _summarize(entries) +    return ProjectMemory(ok=not error, paper_id=paper_id, +                         entries=entries, summary=summary, error=error) + + +def _summarize(entries: list[dict]) -> list[dict]: +    counts: dict[str, int] = {} +    last = {} +    for e in entries: +        counts[e.get("action", "?")] = counts.get(e.get("action", "?"), 0) + 1 +    statuses = [e.get("status") for e in entries if e.get("status")] +    milestones = [e.get("milestone") for e in entries if e.get("milestone")] +    return [ +        {"entries": len(entries), +         "by_action": counts, +         "last_status": statuses[-1] if statuses else "", +         "milestones": milestones, +         "has_plan_backlog": bool(milestones) or len(entries) >= 3}, +    ] \ No newline at end of file diff --git a/clawsgo_self/deliver/package.py b/clawsgo_self/deliver/package.py new file mode 100644 index 0000000..c3c9485 --- /dev/null +++ b/clawsgo_self/deliver/package.py @@ -0,0 +1,142 @@ +"""鎶曠鏉愭枡涓€閿墦鍖咃紙package锛夛細鎶婅鏂囧鍑虹墿銆佺爺绌朵骇鐗╀笌澶嶇幇浜や粯鐗╂墦鎴?zip锛?+骞惰嚜鍔ㄧ敓鎴?cover letter 涓庢姇绋?checklist銆?+ +绾爣鍑嗗簱 zipfile锛涗骇鐗╄惤鍦?projects/{paper_id}/submission_*.zip銆?+""" + +from __future__ import annotations + +import json +import time +import zipfile +from pathlib import Path + +from clawsgo_self.core import Layout, clean_segment + + +def _project_files(root: Path) -> list[Path]: +    out = [] +    for p in sorted(root.rglob("*")): +        if not p.is_file(): +            continue +        rel = p.relative_to(root).as_posix() +        if "submission_" in rel and rel.endswith(".zip"): +            continue +        out.append(p) +    return out + + +def _task_files(layout: Layout, task_id: str) -> list[Path]: +    if not task_id: +        return [] +    root = layout.task_dir(task_id) +    return [p for p in sorted(root.rglob("*")) if p.is_file()] + + +def _paper_head(layout: Layout, paper_id: str) -> dict: +    title, abstract = paper_id, "" +    meta = layout.project_dir(paper_id) / "research" / "metadata.json" +    if meta.exists(): +        try: +            data = json.loads(meta.read_text(encoding="utf-8")) +            title = data.get("title") or paper_id +            abstract = data.get("abstract") or "" +        except (OSError, ValueError): +            pass +    return {"title": title, "abstract": abstract} + + +def _cover_letter(info: dict) -> str: +    title = info["title"] +    abstract = info["abstract"] +    return ( +        f"# Cover Letter\n\n" +        f"Dear Editor / Program Chairs,\n\n" +        f"We are pleased to submit our manuscript titled銆寋title}銆峟or your consideration.\n\n" +        "This work makes the following contributions:\n" +        "- 閽堝璧勬簮鐨勭郴缁熷寲寤烘ā涓庢眰瑙ｆ柟妗堬紙璇﹁鎽樿涓庢鏂囷級銆俓n" +        "- 瀹為獙涓庡鐜颁骇鐗╁畬鏁村彲鏌ワ紝鍏ㄩ儴浠ｇ爜銆佹暟鎹笌鍥捐〃鍧囧彲澶嶇幇銆俓n\n" +        f"Abstract: {abstract[:400] or '锛堣绋夸欢鎽樿锛?}\n\n" +        "We believe the manuscript is within the scope of your venue and has not been " +        "published elsewhere. We look forward to your review.\n\n" +        "Sincerely,\nThe Authors\n" +    ) + + +def _checklist(has_export: list[str]) -> str: +    items = [ +        "鏍囬 / 鎽樿 / 鍏抽敭璇?瀹屾暣", +        "寮曡█鏄庣‘鐮旂┒缂哄彛涓庤础鐚?, +        "鏂规硶绔犺妭鍚缓妯′笌姹傝В琛ㄨ堪", +        "瀹為獙缁撴灉鍚寚鏍囦笌鍥撅紙鍙鐜帮級", +        "鍙傝€冩枃鐚牸寮忕粺涓€涓斿瓧娈靛畬鏁?, +        "澶嶇幇浠ｅ寲鐮?/ 鏁版嵁 / 鍥捐〃鎵撳寘榻愬叏", +        "Cover letter 宸查檮", +        "鏃犻殣绉佹垨鏈巿鏉冩暟鎹硠闇?, +    ] +    lines = [f"- [x] {it}" if it in ( +        "澶嶇幇浠ｅ寲鐮?/ 鏁版嵁 / 鍥捐〃鎵撳寘榻愬叏", +        "Cover letter 宸查檮", +    ) else f"- [ ] {it}" for it in items] +    return "\n".join(["# 鎶曠鍓?Checklist", ""] + lines + [ +        "", +        f"宸叉墦鍖呯殑瀵煎嚭鐗╋細{(', '.join(has_export) or '鏃?)}", +        "璇存槑锛歚[ ]` 椤硅浣滆€呬汉宸ョ‘璁ゅ悗鍕鹃€夈€?, +    ]) + + +def package_submission( +    *, +    paper_id: str, +    layout: Layout, +    task_id: str = "", +) -> dict: +    """鎵撳寘鎶曠鏉愭枡锛涜繑鍥?{ok, zip_path, files:[...], cover_letter, checklist}銆?"" +    seg = clean_segment(paper_id) +    project = layout.projects_dir / seg +    if not project.exists(): +        return {"ok": False, "paper_id": paper_id, "error": f"椤圭洰 {paper_id} 涓嶅瓨鍦ㄣ€?} + +    files = _project_files(project) +    if not files: +        return {"ok": False, "paper_id": paper_id, "error": f"椤圭洰 {paper_id} 鏃犲唴瀹瑰彲鎵撳寘銆?} + +    info = _paper_head(layout, paper_id) +    cover = _cover_letter(info) +    exported = [ +        p.name for p in files +        if p.suffix.lower() in (".pdf", ".docx", ".tex", ".html") +    ] +    chk = _checklist(exported) + +    ts = time.strftime("%Y%m%d_%H%M%S") +    zip_path = project / f"submission_{ts}.zip" + +    manifest: list[dict] = [] +    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z: +        for p in files: +            arc = "paper/" + p.relative_to(project).as_posix() +            z.write(p, arc) +            manifest.append({"arc": arc, "size": p.stat().st_size}) +        z.writestr("cover_letter.md", cover) +        manifest.append({"arc": "cover_letter.md", "size": len(cover.encode("utf-8"))}) +        z.writestr("submission_checklist.md", chk) +        manifest.append({"arc": "submission_checklist.md", "size": len(chk.encode("utf-8"))}) +        if task_id: +            for p in _task_files(layout, task_id): +                rel = p.relative_to(layout.task_dir(task_id)).as_posix() +                arc = "reproduction/" + rel +                z.write(p, arc) +                manifest.append({"arc": arc, "size": p.stat().st_size}) + +    return { +        "ok": True, +        "paper_id": paper_id, +        "zip_path": str(zip_path), +        "zip_size": zip_path.stat().st_size, +        "file_count": len(manifest), +        "files": manifest, +        "cover_letter": cover, +        "checklist": chk, +        "note": "濡傞渶涓婁紶瀹＄绯荤粺锛岀洿鎺ヤ娇鐢ㄨ zip锛沜over letter 涓?checklist 宸插唴缃€?, +    } \ No newline at end of file diff --git a/clawsgo_self/reproduce/codereview.py b/clawsgo_self/reproduce/codereview.py new file mode 100644 index 0000000..24b1dd5 --- /dev/null +++ b/clawsgo_self/reproduce/codereview.py @@ -0,0 +1,241 @@ +"""澶嶇幇浠ｇ爜闈欐€佺偣璇勶紙codereview锛夛細瀵?tasks/{id}/ 涓嬬殑 .py 鐢熸垚鍙淮鎶?+浣嗘棤鎵瑰垽鎬т粬閫犻敊璇殑椋庢牸涓庨闄╂竻鍗曪紝鏀拺璁烘枃澶嶇幇鐨勪唬鐮佽川閲忓０鏄庛€?+ +绾潤鎬佽鍒?+ 杞婚噺妯″紡鍖归厤锛涙棤闇€杩愯浠ｇ爜/缃戠粶銆?+""" + +from __future__ import annotations + +import ast +import json +import re +from dataclasses import dataclass, field +from pathlib import Path + +from clawsgo_self.core import Layout, clean_segment + + +@dataclass +class FileNote: +    path: str +    stats: dict +    issues: list +    ok: bool + +    def to_dict(self) -> dict: +        return {"path": self.path, "stats": self.stats, +                "issues": self.issues, "ok": self.ok} + + +@dataclass +class CodeReviewResult: +    ok: bool +    task_id: str = "" +    files: list = field(default_factory=list) +    scores: dict = field(default_factory=dict) +    checklist: list = field(default_factory=list) +    warnings: list = field(default_factory=list) +    error: str = "" + +    def to_dict(self) -> dict: +        return {"ok": self.ok, "task_id": self.task_id, "files": self.files, +                "scores": self.scores, "checklist": self.checklist, +                "warnings": self.warnings, "error": self.error} + +    def to_markdown(self) -> str: +        lines = [f"# 澶嶇幇浠ｇ爜鐐硅瘎锛歿self.task_id}", ""] +        if self.files: +            lines.append(f"鍏?{len(self.files)} 涓?Python 鏂囦欢銆傛€诲垎 " +                         f"`{self.scores.get('total','-')}/100`锛岀粨鏋?" +                         f"`{self.scores.get('structure','-')}`锛屾暟鍊?" +                         f"`{self.scores.get('numeric','-')}`锛屽悗绔?" +                         f"`{self.scores.get('backend','-')}`锛岄闄?" +                         f"`{self.scores.get('risk','-')}`") +            lines.append("") +            for f in self.files: +                lines.append(f"### {f['path']}锛坽f['stats']['loc']} 琛?/ " +                             f"{f['stats']['functions']} 鍑芥暟 / {f['stats']['classes']} 绫伙級") +                if f["issues"]: +                    for it in f["issues"][:20]: +                        lines.append(f"- [{it['category']}] {it['line']}: {it['message']}") +                else: +                    lines.append("- 鏃犳槑鏄鹃棶棰?) +                lines.append("") +        else: +            lines.append("锛堟湭鍙戠幇鍙偣璇勭殑 Python 鏂囦欢锛?) +        if self.checklist: +            lines.append("## 璁烘枃鍙俊搴︽鏌?) +            lines.extend(f"- [{('x' if c['pass'] else ' ')}] {c['text']}" for c in self.checklist) +        if self.warnings: +            lines.append("## 鎻愮ず") +            lines.extend(f"- {w}" for w in self.warnings) +        return "\n".join(lines) + + +_NUMERIC_RE = re.compile(r"(seed|epochs?|batch_?size|lr|learning_rate|dropout|layers?|" +                         r"hidden|dim(?:ension)?s?|num_|best|score|acc(?:uracy)?|" +                         r"f1|recall|precision|result|metric)", re.I) +_BACKEND_RE = re.compile(r"(torch|tensorflow|keras|tf\.|flax|jax|paddle|sklearn)", re.I) +_DANGER = [ +    ("pandas", "pd.read_csv"), +    ("panic", "raise NotImplementedError"), +    ("rand", "np.random.seed"), +    ("rand", "torch.manual_seed"), +    ("hardcode", "best_hyper"), +    ("temp", "tempfile"), +] +_SMELLS = [ +    (re.compile(r"\bprint\("), "debug", "鍖呭惈 print 璋冭瘯锛涘缓璁粺涓€鏃ュ織"), +    (re.compile(r"\bpass\b"), "stub", "瀛樺湪 pass 鍗犱綅锛岀枒浼兼湭瀹屾垚閫昏緫"), +    (re.compile(r"\bexcept\s*[^:]*:\s*$", re.M), "catch", "瑁?except 鍚炲紓甯?), +    (re.compile(r"\btodo\b", re.I), "todo", "閬楃暀 TODO"), +    (re.compile(r"\bassert\s"), "assert", "鏂█娣峰叆鏁版嵁璺緞锛屽彂甯冩椂寤鸿绉婚櫎"), +] + +_MAGIC_HYPER = ["best", "magic", "secret", "acc=", "acc=", "=0.9", "=0.99"] + + +def _scan_py(path: Path) -> FileNote: +    txt = path.read_text(encoding="utf-8", errors="replace") +    lines = txt.splitlines() +    issues: list[dict] = [] + +    def add(cat, line, msg): +        issues.append({"category": cat, "line": line, "message": msg}) + +    try: +        tree = ast.parse(txt) +    except SyntaxError as e: +        add("syntax", e.lineno or 1, f"璇硶閿欒锛歿e.msg}") +        tree = None + +    funcs = classes = 0 +    imports: set[str] = set() +    seed_lines: list[int] = [] +    if tree is not None: +        for node in ast.walk(tree): +            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)): +                funcs += 1 +            elif isinstance(node, ast.ClassDef): +                classes += 1 +            elif isinstance(node, ast.Import): +                imports.update(a.name.split(".")[0] for a in node.names) +            elif isinstance(node, ast.ImportFrom): +                if node.module: +                    imports.add(node.module.split(".")[0]) +            elif isinstance(node, ast.Assign): +                for t in node.targets: +                    if isinstance(t, ast.Name): +                        if _NUMERIC_RE.search(t.id) and isinstance(node.value, ast.Constant): +                            v = node.value.value +                            if isinstance(v, (int, float)): +                                if t.id in ("best_acc", "best_loss") or "magic" in t.id: +                                    add("hardcode", node.lineno, +                                        f"瓒呭弬 {t.id}={v} 鐤戜技纭紪鐮侊紱寤鸿鍐欏叆閰嶇疆") +                    if t.id in ("seed", "random_seed"): +                        seed_lines.append(node.lineno) +    else: +        # AST 澶辫触鏃堕€€鍥炵畝鍗曠殑琛岀骇鎵弿 +        for i, ln in enumerate(lines, 1): +            m = _NUMERIC_RE.search(ln) +            if m and re.search(r"=\s*\d", ln) and " " not in ln.strip()[:3]: +                add("hardcode", i, "鐤戜技榄旀硶鏁帮紝寤鸿甯搁噺鍖?) + +    has_seed = len(seed_lines) > 0 or "seed" in txt.lower() +    has_backend = bool(_BACKEND_RE.search(txt)) + +    loc = len([ln for ln in lines if ln.strip() and not ln.strip().startswith("#")]) +    for pat, cat, msg in _SMELLS: +        for i, ln in enumerate(lines, 1): +            if pat.search(ln): +                add(cat, i, msg) + +    # DANGER 鍏抽敭璇嶆鏌?+    for label, kw in _DANGER: +        if kw.lower() in txt.lower(): +            add("risk", 0, f"鍖呭惈 {label} 鐗瑰緛锛坽kw}锛夛細璇峰鏍搁殢鏈烘€т笌澶嶇幇涓€鑷存€?) + +    if not has_seed and has_backend: +        add("repro", 0, "鏈彂鐜伴殢鏈虹瀛愯缃紝澶氭杩愯缁撴灉鍙兘涓嶅彲澶嶇幇") + +    return FileNote( +        path=path.name, +        stats={"loc": loc, "functions": funcs, "classes": classes, +               "imports": sorted(imports), +               "has_seed": has_seed, "has_backend": has_backend}, +        issues=issues, +        ok=not any(i["category"] in ("syntax",) for i in issues), +    ) + + +def review_code(*, task_id: str, layout: Layout) -> CodeReviewResult: +    safe = clean_segment(task_id) +    root = layout.tasks_dir / safe +    if not root.exists(): +        return CodeReviewResult(ok=False, task_id=task_id, +                                error=f"浠诲姟 {task_id} 涓嶅瓨鍦ㄣ€?) +    pys = [p for p in sorted(root.rglob("*.py")) if p.name != "__init__.py"] +    notes = [_scan_py(p) for p in pys] +    r = CodeReviewResult(ok=True, task_id=task_id, +                         files=[n.to_dict() for n in notes]) + +    # 璇勫垎 +    n = len(notes) +    structure = 0.0 +    numeric = 0.0 +    backend = 0.0 +    risk = 0.0 +    for note in notes: +        st = note.stats +        if st["functions"] >= 2 or st["classes"] >= 1: +            structure += 100 / n +        else: +            structure += 40 / n +        if st["has_seed"]: +            numeric += 100 / n +        else: +            numeric += 0.0 +        if st["has_backend"]: +            backend += 100 / n +        else: +            backend += 80 / n +        bad = sum(1 for i in note.issues if i["category"] in ("syntax", "repro", "hardcode", "risk")) +        risk += max(0.0, 100 - 25 * bad) / n +    r.scores = { +        "total": round(structure * 0.35 + numeric * 0.25 + backend * 0.2 + risk * 0.2, 1), +        "structure": round(structure, 1), +        "numeric": round(numeric, 1), +        "backend": round(backend, 1), +        "risk": round(risk, 1), +    } + +    # 璁烘枃鍙俊搴?checklist +    any_seed = any(n.stats["has_seed"] for n in notes) +    r.checklist = [ +        {"text": "鍚殢鏈虹瀛愯缃紙缁撴灉鍙鐜帮級", "pass": any_seed}, +        {"text": "姣忛」瓒呭弬鏈夊搴旈厤缃?鏂囨。", "pass": not any( +            i["category"] == "hardcode" for f in r.files for i in f["issues"])}, +        {"text": "鏃犺８ except / panic 鍗犱綅", "pass": not any( +            i["category"] in ("catch", "panic") for f in r.files for i in f["issues"])}, +        {"text": "鏃犳畫鐣?TODO / debug print", "pass": not any( +            i["category"] in ("debug", "todo") for f in r.files for i in f["issues"])}, +    ] + +    # 鎻愮ず +    if n == 0: +        r.warnings.append("浠诲姟鍐呮棤 Python 鏂囦欢锛氳纭澶嶇幇浜х墿宸茬敓鎴愩€?) +    if not any_seed: +        r.warnings.append("鏃犻殢鏈虹瀛愶細鑻ユ寚鏍囨槸澶氭鍧囧€硷紝璇峰湪璁烘枃涓敞鏄庛€?) + +    r.ok = True +    _persist(layout, task_id, r) +    return r + + +def _persist(layout: Layout, task_id: str, r: CodeReviewResult): +    root = layout.task_dir(task_id) +    root.mkdir(parents=True, exist_ok=True) +    (root / "code_review.json").write_text( +        json.dumps(r.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8" +    ) +    (root / "code_review.md").write_text(r.to_markdown(), encoding="utf-8") \ No newline at end of file diff --git a/clawsgo_self/research/bench.py b/clawsgo_self/research/bench.py new file mode 100644 index 0000000..38eabea --- /dev/null +++ b/clawsgo_self/research/bench.py @@ -0,0 +1,221 @@ +"""瀵规瘮琛ㄤ笌鏄捐憲鎬ф楠岋紙bench锛夛細姹囨€诲娆′换鍔?鍩虹嚎鎸囨爣锛屼骇鍑鸿鏂囧彲鐢ㄥ姣旇〃銆?+ +璇诲彇鍚?tasks/{id}/results.json 鐨勬寚鏍囧簭鍒楋紙metrics 涓?tag/value 鍒楄〃锛夛紝 +鎸?tag 鍒嗙粍寰楀埌鏍锋湰搴忓垪锛涘姣忎釜 tag 杈撳嚭鍧囧€悸眘td锛?+骞堕拡瀵瑰熀绾垮仛 Welch t 妫€楠屼笌 Mann-Whitney U 妫€楠屻€傜函鏍囧噯搴撱€?+""" + +from __future__ import annotations + +import json +from dataclasses import dataclass, field + +from clawsgo_self.core import Layout +from clawsgo_self.research import stats + +_ALPHA = 0.05 + + +def _lower_is_better(tag: str) -> bool: +    t = tag.lower() +    return any(k in t for k in ("loss", "error", "mse", "mae", "rmse")) + + +@dataclass +class BenchResult: +    ok: bool +    paper_id: str = "" +    metric_rows: list = field(default_factory=list) +    tests: list = field(default_factory=list) +    errors: list = field(default_factory=list) +    error: str = "" + +    def to_dict(self) -> dict: +        return { +            "ok": self.ok, "paper_id": self.paper_id, +            "metric_rows": self.metric_rows, "tests": self.tests, +            "errors": self.errors, "error": self.error, +        } + +    def to_markdown(self) -> str: +        parts = [f"# 瀵规瘮琛細{self.paper_id}"] +        if not self.metric_rows: +            parts.append("\n锛堟棤鍙敤鎸囨爣锛屾棤娉曠敓鎴愬姣旇〃锛?) +        else: +            tasks = [r["task"] for r in self.metric_rows] +            tags = [] +            for r in self.metric_rows: +                for i in r["items"]: +                    if i["tag"] not in tags: +                        tags.append(i["tag"]) +            head = ["鎸囨爣"] + tasks +            parts.append("\n| " + " | ".join(head) + " |") +            parts.append("|" + "---|" * len(head)) +            for tag in tags: +                cells = [tag] +                for r in self.metric_rows: +                    cells.append(_cell(r, tag)) +                parts.append("| " + " | ".join(cells) + " |") +        if self.tests: +            parts.append("\n## 鏄捐憲鎬ф楠岋紙瀵圭収缁勶細" + (self.tests[0].get("baseline") or "-") + ")") +            for item in self.tests: +                tag = item["tag"] +                e = item["else_group"] +                base = item["baseline_group"] +                g = _sig_cell(item) +                parts.append( +                    f"- `{tag}`锛歿e} vs {base} 鈫?{g}" +                ) +        return "\n".join(parts) + + +def _cell(row: dict, tag: str) -> str: +    for it in row["items"]: +        if it["tag"] == tag: +            return f"{it['mean']:.3f}卤{it['std']:.3f} (n={it['n']})" +    return "鈥? + + +def _sig_cell(item: dict) -> str: +    t = item["t_test"] +    m = item["mann_whitney"] +    parts = [] +    if isinstance(t, dict) and t.get("p") is not None and math_isfinite(t.get("p")): +        parts.append(f"t={t['t']:.3f} p={t['p']:.4f} {'鏄捐憲' if t['different'] else '涓嶆樉钁?}") +    if isinstance(m, dict) and m.get("p") is not None and math_isfinite(m.get("p")): +        parts.append(f"U={m['u1']:.1f} p={m['p']:.4f} {'鏄捐憲' if m['different'] else '涓嶆樉钁?}") +    return "; ".join(parts) if parts else "鏍锋湰涓嶈冻" + + +def math_isfinite(v) -> bool: +    import math + +    return isinstance(v, (int, float)) and math.isfinite(v) + + +def _read_metrics(task_root) -> dict: +    """杩斿洖 {tag: [values]}銆傝皟鐢ㄦ柟宸茬‘淇濈洰褰曞瓨鍦ㄣ€?"" +    p = task_root / "results.json" +    if not p.exists(): +        return {} +    try: +        data = json.loads(p.read_text(encoding="utf-8")) +    except (OSError, ValueError): +        return {} +    out: dict[str, list] = {} +    for m in data.get("metrics", []) or []: +        tag = (m.get("tag") or m.get("name") or "").strip() +        v = m.get("value") +        if not tag or v is None: +            continue +        try: +            v = float(v) +        except (TypeError, ValueError): +            continue +        out.setdefault(tag, []).append(v) +    return out + + +def compare_metrics( +    *, +    paper_id: str, +    task_ids: list[str], +    layout: Layout, +    baseline: str = "", +    metric: str = "", +) -> BenchResult: +    """瀵规瘮琛細鑱氬悎澶氫釜 task 鐨勬寚鏍囧苟鍋氭樉钁楁€ф楠屻€?"" +    r = BenchResult(ok=False, paper_id=paper_id) +    if not task_ids: +        r.error = "璇锋彁渚涜嚦灏戜竴涓?task_id銆? +        return r +    rows: list[dict] = [] +    baseline_key = baseline or (task_ids[0] if len(task_ids) > 1 else "") +    for tid in task_ids: +        task_root = layout.task_dir(tid) +        series = _read_metrics(task_root) +        if not series: +            r.errors.append(f"浠诲姟 {tid} 娌℃湁鍙敤鎸囨爣銆?) +            continue +        items = [] +        for tag, vals in series.items(): +            vals = [v for v in vals if v is not None] +            if not vals: +                continue +            items.append({ +                "tag": tag, "mean": stats.mean(vals), +                "std": stats.stddev(vals) if len(vals) > 1 else 0.0, +                "n": len(vals), "lower_better": _lower_is_better(tag), +            }) +        if items: +            rows.append({"task": tid, "items": items, +                         "all_tags": sorted(set(i["tag"] for i in items))}) +    if metric: +        for row in rows: +            row["items"] = [i for i in row["items"] if metric.lower() in i["tag"].lower()] +            row["all_tags"] = sorted(set(i["tag"] for i in row["items"])) +    rows = [row for row in rows if row["items"]] +    r.metric_rows = rows +    if not rows: +        r.error = "娌℃湁鍙姣旂殑鎸囨爣搴忓垪銆? +        return r +    r.ok = True + +    # 鏄捐憲鎬э細閫愪釜闈炲熀绾?task vs baseline +    tests = [] +    base_row = next((row for row in rows if row["task"] == baseline_key), None) +    if base_row is None and len(rows) >= 2: +        base_row = rows[0] +    if base_row is not None: +        base_tags = {i["tag"]: i for i in base_row["items"]} +        for row in rows: +            if row["task"] == base_row["task"]: +                continue +            for item in row["items"]: +                if item["tag"] not in base_tags: +                    continue +                x = _raw_series(task_ids, row["task"], item["tag"], layout) +                y = _raw_series(task_ids, base_row["task"], item["tag"], layout) +                if len(x) < 2 or len(y) < 2: +                    continue +                t = stats.welch_t(x, y) +                m = stats.mann_whitney_u(x, y) +                tests.append({ +                    "tag": item["tag"], +                    "else_group": row["task"], +                    "baseline_group": base_row["task"], +                    "t_test": _round_dict(t), +                    "mann_whitney": _round_dict(m), +                    "direction": "lower_better" if item["lower_better"] else "higher_better", +                }) +    r.tests = tests +    _persist(layout, paper_id, r) +    return r + + +def _raw_series(task_ids: list[str], tid: str, tag: str, layout: Layout) -> list[float]: +    series = _read_metrics(layout.task_dir(tid)) +    return [v for v in series.get(tag, []) if v is not None] + + +def _round_dict(d: dict) -> dict: +    out = {} +    for k, v in d.items(): +        if k == "p": +            out[k] = round(v, 9) if isinstance(v, float) else v +        elif isinstance(v, float): +            out[k] = round(v, 6) +        elif isinstance(v, dict): +            out[k] = _round_dict(v) +        else: +            out[k] = v +    return out + + +def _persist(layout: Layout, paper_id: str, r: BenchResult): +    root = layout.project_dir(paper_id) / "research" +    root.mkdir(parents=True, exist_ok=True) +    (root / "benchmark_compare.json").write_text( +        json.dumps(r.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8" +    ) +    (root / "benchmark_compare.md").write_text(r.to_markdown(), encoding="utf-8") \ No newline at end of file diff --git a/clawsgo_self/research/community.py b/clawsgo_self/research/community.py new file mode 100644 index 0000000..956e5b0 --- /dev/null +++ b/clawsgo_self/research/community.py @@ -0,0 +1,167 @@ +"""寮曟枃閭诲煙涓庣儹搴﹀垎鏋愶紙community锛夛細鍥寸粫涓€涓?DOI 鎴栦富棰樿瘝锛屽垎鏋愮浉鍏冲伐浣滅殑 +琚紩鐑害銆佸勾搴﹀垎甯冧笌杞戒綋鍒嗗竷锛岃緟鍔╁垽鏂€夐鍐风儹涓庡垏鍏ユ椂鏈恒€?+ +澶嶇敤 lit.py 鐨?OpenAlex 鍏?key 閫氶亾锛岀绾挎椂鍥為€€鍚彂寮忔ā鏉裤€?+""" + +from __future__ import annotations + +import json +import re +import urllib.parse +from dataclasses import dataclass, field +from collections import Counter + +from clawsgo_self.core import Layout +from clawsgo_self.research import lit + + +@dataclass +class CitationLandscape: +    ok: bool +    paper_id: str = "" +    source: str = ""          # 浼犲叆鐨?doi 鎴?topic +    mode: str = "topic"       # doi | topic +    headline: str = "" +    total_works: int = 0 +    max_cited: int = 0 +    works_by_year: list = field(default_factory=list) +    top_cited: list = field(default_factory=list) +    venues: list = field(default_factory=list) +    notes: list = field(default_factory=list) +    error: str = "" +    offline: bool = False + +    def to_dict(self) -> dict: +        return { +            "ok": self.ok, "paper_id": self.paper_id, "source": self.source, +            "mode": self.mode, "headline": self.headline, +            "total_works": self.total_works, "max_cited": self.max_cited, +            "works_by_year": self.works_by_year, "top_cited": self.top_cited, +            "venues": self.venues, "notes": self.notes, +            "error": self.error, "offline": self.offline, +        } + +    def to_markdown(self) -> str: +        y = "\n".join( +            f"- {d['year']}: {d['count']} 绡? for d in self.works_by_year +        ) or "- 锛堟棤骞村害鏁版嵁锛? +        top = "\n".join( +            f"- [{p.get('year','?')}] {p.get('title','')} 鈥?" +            f"{p.get('venue','')}锛岃寮?{p.get('cited_by',0)}" +            for p in self.top_cited[:10] +        ) or "- 锛堟棤鐩稿叧浣滃搧锛? +        ven = "\n".join( +            f"- {v['venue']}: {v['count']} 绡? for v in self.venues[:10] +        ) or "- 锛堟棤杞戒綋鏁版嵁锛? +        notes = "\n".join(f"- {n}" for n in self.notes) or "- 锛堟棤棰濆璇存槑锛? +        return "\n\n".join([ +            f"# 寮曟枃閭诲煙鍒嗘瀽锛歿self.paper_id}", +            f"## 姒傝\n{self.headline or '锛堟棤鏁版嵁锛?}\n\n" +            f"- 鏈夋晥浣滃搧鏁帮細{self.total_works}\n- 鏈€楂樿寮曪細{self.max_cited}", +            f"## 骞村害鍒嗗竷\n{y}", +            f"## 楂樿寮曚唬琛╘n{top}", +            f"## 涓昏杞戒綋\n{ven}", +            f"## 缁撹涓庢彁绀篭n{notes}", +        ]) + + +def _fetch_work_by_doi(doi: str, timeout: int = 20) -> dict: +    if lit._offline(): +        return {} +    clean = re.search(r"(10\.\d{4,9}/[^\s]+)", doi or "") +    if not clean: +        return {} +    d = clean.group(1).rstrip(".,)") +    url = "https://api.openalex.org/works?filter=doi:" + urllib.parse.quote(d) + "&per-page=1" +    data = lit._get_json(url, timeout=timeout) +    for w in (data.get("results") if data else []) or []: +        return {"title": w.get("title") or "", +                "year": w.get("publication_year"), +                "doi": w.get("doi"), +                "venue": (w.get("primary_location") or {}).get("display_name") or "", +                "cited_by": w.get("cited_by_count") or 0} +    return {} + + +def _time_window(total: int, max_cited: int) -> str: +    if total < 30: +        return "閭诲煙浠嶈緝灏忥紝灞炰簬鏃╂湡/闀垮熬鏂瑰悜锛氭満浼氬ぇ浣嗚鑰呭熀鏁版湁闄愶紝寤鸿鍊熺儹鐐瑰満鏅垏鍏ャ€? +    if max_cited >= 1000: +        return "閭诲煙楂樼儹锛堝瓨鍦ㄥ崈浜哄紩浠ｈ〃浣滐級锛氬缓璁伩寮€纭垰锛屾壘瀛愰棶棰?涓撶敤鍦烘櫙鍋氬樊寮傚寲銆? +    return "閭诲煙涓瓑鍋忕儹锛氭湁瀵硅瘽鑰呫€佹湁鍙姣斿熀绾匡紝閫傚悎蹇€熶骇鍑哄彂鏂囥€? + + +def citation_landscape( +    *, +    paper_id: str, +    layout: Layout, +    doi_or_topic: str, +    sources: list[str] | None = None, +) -> CitationLandscape: +    """寮曟枃鐑害鍒嗘瀽锛欴OI 鐢?OpenAlex 绮剧‘鏌ワ紱鍚﹀垯鎸変富棰樻绱€?"" +    r = CitationLandscape(ok=False, paper_id=paper_id, source=doi_or_topic) + +    doi_like = bool(re.search(r"10\.\d{4,9}/", doi_or_topic or "")) +    r.mode = "doi" if doi_like else "topic" + +    works: list[dict] = [] +    if r.mode == "doi": +        seed = _fetch_work_by_doi(doi_or_topic) +        if not seed: +            r.offline = lit._offline() +            r.notes.append("DOI 鍦?OpenAlex 鏈懡涓紙鍙兘绂荤嚎/鎷煎啓闂锛夈€?) +            r.headline = "鏃犳硶瀹氫綅璇?DOI 鐨勫紩鏂囬偦鍩燂紝璇锋鏌?DOI 鎴栨敼鐢ㄤ富棰樺叧閿瘝銆? +        else: +            works.append(seed) +            r.notes.append(f"浠?DOI 瀹氫綅鍒般€寋seed.get('title','')[:60]}銆嶏紝" +                           f"琚紩 {seed.get('cited_by',0)}銆?) +    else: +        from clawsgo_self.science.api import cross_lookup +        if sources: +            works = cross_lookup(doi_or_topic, databases=sources, limit=40) +        else: +            works = lit.search_openalex(doi_or_topic, limit=40) +        if not works: +            r.offline = lit._offline() +            r.notes.append("涓婚妫€绱㈡棤缁撴灉锛堢绾挎垨鍏抽敭璇嶈繃鍐烽棬锛夈€?) +            r.headline = "鏈绱㈠埌鐩稿叧浣滃搧锛屽缓璁洿鎹㈠叧閿瘝鍚庡啀璇曘€? +        else: +            r.notes.append("鍩轰簬涓婚妫€绱?top 浣滃搧鐨勮寮曢噺鍒ゆ柇棰嗗煙鐑害銆?) + +    if not works: +        r.error = "鏃犲彲鐢ㄥ紩鏂囨暟鎹紙绂荤嚎鎴栨湭鍛戒腑锛夈€? +        return r + +    r.total_works = len(works) +    r.max_cited = max(w.get("cited_by", 0) for w in works) +    r.headline = _time_window(r.total_works, r.max_cited) + +    by_year = Counter() +    for w in works: +        yr = w.get("year") +        if yr: +            by_year[yr] += 1 +    r.works_by_year = [{"year": y, "count": c} for y, c in sorted(by_year.items())] + +    r.top_cited = sorted(works, key=lambda w: w.get("cited_by", 0), reverse=True)[:15] + +    venues = Counter() +    for w in works: +        v = (w.get("venue") or "").strip() +        if v: +            venues[v] += 1 +    r.venues = [{"venue": v, "count": c} for v, c in venues.most_common()] + +    _persist(layout, paper_id, r) +    r.ok = True +    return r + + +def _persist(layout: Layout, paper_id: str, r: CitationLandscape): +    root = layout.project_dir(paper_id) / "research" +    root.mkdir(parents=True, exist_ok=True) +    (root / "citation_landscape.json").write_text( +        json.dumps(r.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8" +    ) +    (root / "citation_landscape.md").write_text(r.to_markdown(), encoding="utf-8") \ No newline at end of file diff --git a/clawsgo_self/research/extract.py b/clawsgo_self/research/extract.py new file mode 100644 index 0000000..501caf8 --- /dev/null +++ b/clawsgo_self/research/extract.py @@ -0,0 +1,256 @@ +"""鏍囬/鎽樿/鍏抽敭璇嶆彁鐐硷紙auto_title_abstract锛夛細浠庡凡鏈夋鏂囩敓鎴愭姇绋挎墍闇€鐨勫厓鏁版嵁銆?+ +璇诲彇 projects/{paper_id}/doc.md锛堟垨 sections/锛夛紝浜у嚭 +  - title锛堣嫢姝ｆ枃鏃犳爣棰橈紝浠庨琛?鍏抽敭璇嶅惎鍙戝紡鐢熸垚锛?+  - abstract锛堣嫢姝ｆ枃宸叉湁鎽樼珷鑺傚垯鎽樺綍锛屽惁鍒欑敤寮曡█棣栨鎷艰锛?+  - keywords +钀界洏 projects/{paper_id}/research/metadata.json + md銆?+鏃?LLM 鏃剁‘瀹氭€у洖閫€銆?+""" + +from __future__ import annotations + +import json +import re +from dataclasses import dataclass, field +from pathlib import Path + +from clawsgo_self.core import Layout +from clawsgo_self.core import model as llm +from clawsgo_self.write.doc import DocStore + + +@dataclass +class Metadata: +    ok: bool +    paper_id: str = "" +    title: str = "" +    abstract: str = "" +    keywords: list = field(default_factory=list) +    source: str = "" +    notes: list = field(default_factory=list) +    error: str = "" +    llm_used: bool = False + +    def to_dict(self) -> dict: +        return {k: getattr(self, k) for k in ( +            "ok", "paper_id", "title", "abstract", "keywords", "source", +            "notes", "error", "llm_used", +        )} + +    def to_markdown(self) -> str: +        return "\n\n".join([ +            f"# 璁烘枃鍏冩暟鎹紙{self.paper_id}锛?, +            f"**鏍囬锛?* {self.title}", +            f"**鏉ユ簮锛?* {self.source}", +            f"## 鎽樿\n{self.abstract or '锛堟殏鏃狅級'}", +            f"## 鍏抽敭璇峔n" + (", ".join(self.keywords) if self.keywords else "锛堟殏鏃狅級"), +        ]) + + +def _read_doc(layout: Layout, paper_id: str) -> str: +    doc = DocStore(layout, paper_id) +    parts = [] +    if doc.doc_md.exists(): +        parts.append(doc.doc_md.read_text(encoding="utf-8")) +    else: +        for f in sorted(doc.sections_dir.glob("*.md")): +            parts.append(f.read_text(encoding="utf-8")) +    return "\n".join(parts) + + +def auto_title_abstract( +    *, +    paper_id: str, +    layout: Layout, +) -> Metadata: +    r = Metadata(ok=False, paper_id=paper_id) +    notes: list = [] +    text = _read_doc(layout, paper_id) +    if not text.strip(): +        r.error = f"椤圭洰 {paper_id} 灏氭棤姝ｆ枃锛岃鍏堝啓鍏ュ唴瀹广€? +        r.ok = False +        return r + +    r.title, r.abstract, r.keywords, r.source = _template_meta(text) + +    if llm.configured(): +        try: +            _llm_meta(r, text, notes) +            r.llm_used = True +        except RuntimeError as e: +            notes.append(f"LLM 鎻愮偧涓嶅彲鐢紝淇濈暀妯℃澘缁撴灉锛歿e}") + +    r.notes = notes +    r.ok = True +    _persist(layout, paper_id, r) +    return r + + +def _template_meta(text: str) -> tuple[str, str, list, str]: +    source = "姝ｆ枃鍚彂寮? +    # 鏍囬锛氶涓?markdown H1锛堟敮鎸?doc 椤堕儴 `# 鏍囬`锛?+    m = re.search(r"(?m)^#\s+(.+)$", text) +    title = m.group(1).strip() if m else "" +    if not title: +        # 鍥為€€锛氫粠 H2 鎽樿/寮曡█棣栨鐢熸垚鎺у埗鎬ф爣棰橈紙闀垮害閫備腑銆佸墧闄ゅ彛璇寲寮曞璇嶏級 +        cand = _candidate_title(text) +        title = cand if cand else "" + +    # 鎽樿锛氭壘 ## 鎽樿 / ## 鎽樿锛圓bstract锛?涔嬪悗鐨勬钀?+    absm = re.search(r"(?mis)^#+\s*(鎽樿|abstract)\s*\n+(.*?)(?=\n#+\s|\Z)", text) +    abstract = "" +    if absm: +        abstract = " ".join(absm.group(2).split()).strip() +    elif not abstract: +        # 鍥為€€锛氬紩瑷€棣栦釜瀹炶川娈佃惤 +        intr = re.search(r"(?mis)^#+\s*(寮曡█|introduction|鐮旂┒闂)\s*\n+(.*?)(?=\n#+\s|\Z)", text) +        if intr: +            para = re.search(r"(?m)([^\n#][^\n]{40,})", intr.group(2)) +            abstract = " ".join(para.group(1).strip().split()) if para else "" + +    # 鍏抽敭璇嶏細鎵?鍏抽敭璇?Keywords 琛岋紙": " 褰㈠紡鎴?"## 鍏抽敭璇? 鏍囬褰㈠紡锛?+    kw = re.findall(r"(?im)^\s*(?:鍏抽敭璇峾keywords?)\s*[:锛歖\s*(.+)$", text) +    if not kw: +        kwm = re.search(r"(?mis)^#+\s*(鍏抽敭璇峾keywords?)\s*\n+(.+?)(?=\n#+\s|\Z)", text) +        if kwm: +            kw = [kwm.group(2).strip()] +    keywords = [] +    if kw: +        keywords = [k.strip() for k in re.split(r"[,锛屻€?锛沒", kw[0]) if k.strip()][:8] +    if not keywords: +        words = re.findall(r"[A-Za-z][A-Za-z\-]{2,}", text) +        from collections import Counter +        en_top = [w for w, _ in Counter(w.lower() for w in words).most_common(12) if w not in +                  {"the", "and", "for", "with", "this", "that", "from", "are", "was", "use"}] +        cn_top = _cn_keywords(text) +        # 涓枃姝ｆ枃浼樺厛涓枃鐭锛堝彲闄勪笓鍚嶇缉鍐欙級锛岀函鑻辨枃姝ｆ枃鎵嶅洖閫€鑻辨枃鍗曡瘝 +        if cn_top: +            proper = [w for w in re.findall(r"\b[A-Z][A-Za-z0-9\-]{2,}\b", text) +                      if not any(w in o or o in w for o in cn_top)] +            keywords = (cn_top + proper)[:6] +        else: +            keywords = en_top[:6] +    return title, abstract, keywords, source + + +def _candidate_title(text: str) -> str: +    """鏃犱竴绾ф爣棰樻椂锛屼粠鎽樿/寮曡█棣栨鐢熸垚涓€涓帶鍒舵€ф爣棰樸€?"" +    sec = re.search( +        r"(?mis)^#+\s*(鎽樿|abstract|寮曡█|introduction|鐮旂┒闂)\s*\n+(.*?)(?=\n#+\s|\Z)", +        text, +    ) +    if not sec: +        return "" +    para = re.search(r"(?m)([^\n#][^\n]{20,})", sec.group(2)) +    if not para: +        return "" +    line = " ".join(para.group(1).strip().split()) +    # 鍙栭鍙ワ紝鍐嶅幓鎺夊彛璇寲寮曞鍓嶇紑锛屼繚鐣欐爣棰樹富浣?+    first = re.split(r"[銆傦紒锛?!?锛?]", line)[0].strip(" 锛岋紱;锛?") +    for pat in ( +        r"^(?:鏈伐浣渱鏈枃|鏈爺绌秥鏈柟娉晐鎴戜滑|杩戝勾鏉闅忕潃|閽堝(?:涓婅堪)?)", +        r"^(?:鎻愬嚭|鎵€鎻愬嚭|鎴戜滑鎻愬嚭)", +        r"^(?:涓€绉峾涓€涓獆浜嗕竴绉??", +    ): +        first = re.sub(pat, "", first).strip(" 锛岋紱;锛?") +    if 8 <= len(first) <= 60: +        return first +    return "" + + +_CN_STOP_SINGLE = frozenset( +    "鐨勪竴鍦ㄦ槸鍜屼笌鍙婁簡鎴戞槸浣犱粬濂瑰畠浠繖閭ｄ箣寰堝苟浠ユ垨鑰岃涔熶笉浣嗕腑涓婅兘澶熷灏嗗彧杩囦簺鍛㈠晩鍚у悧琚妸缁欒浠庡悜鍦ㄤ笌鍜屼簬鍥? +) +_CN_STOP_SEQ = ( +    "鎻愬嚭", "鐩爣", "涓€绉?, "涓€涓?, "璁捐", "鏋勫缓", "鎵惧埌", "瀵绘壘", "瀹氫箟", +    "閽堝", "鎴戜滑", "鏈枃", "鐮旂┒", "鎶ュ憡", "璇存槑", "璁＄畻", "浠嬬粛", "閲囩敤", +    "绫昏竟缂?,  # 鈥? 绫昏竟缂樼‖浠垛€濋噷鐨勫簭鏁版畫瀛?+) + + +_CN_TAIL = "鏂规硶妯″瀷绠楁硶鏈哄埗妗嗘灦绛栫暐缃戠粶鎺㈤拡钂搁鍓灊閲忓寲浼樺寲璇勪及鍔犻€熼儴缃蹭紭鍖?  # 瀛︾灏剧紑锛岀敤浜庡姞鍒?+ + +def _cn_keywords(text: str) -> list: +    """涓枃鍏抽敭璇嶅洖閫€锛氭棤鍒嗚瘝 n-gram 棰戠巼缁熻銆?+ +    瀵逛腑鏂囪繛璇绘鏋氫妇 2-5 瀛楃墖娈碉紝鎸夈€岄鐜嚸?闀垮害-1)虏 + 瀛︾灏剧紑鍔犳垚銆嶆墦鍒嗭細 +    璁?4-5 瀛椾富棰樿瘝锛堝ぇ璇█妯″瀷/鐭ヨ瘑钂搁锛変紭鍏堬紝鍚屾椂涓㈠純鍚櫄璇嶆垨鍙欒堪璇嶇殑 +    鍙ュ瓙纰庣墖锛屽啀鐢ㄥ寘鍚叧绯诲幓閲嶏紝閬垮厤浜у嚭鏃犳剰涔夌墖娈点€?+    """ +    from collections import Counter + +    grams: Counter = Counter() +    for run in re.findall(r"[\u4e00-\u9fff]{4,}", text): +        n = len(run) +        for L in range(min(5, n), 1, -1): +            for i in range(n - L + 1): +                g = run[i:i + L] +                # 鍚櫄璇嶏紙鐨?浜?鍦?鏄€︼級鈫?蹇呬负纰庣墖 +                if any(ch in _CN_STOP_SINGLE for ch in g): +                    continue +                # 鍚彊杩拌瘝锛堟彁鍑?涓€绉?璁捐鈥︼級鈫?蹇呬负鍙ュ瓙纰庣墖 +                if any(s in g for s in _CN_STOP_SEQ): +                    continue +                grams[g] += 1 + +    def _score(kv): +        g, c = kv +        return c * (len(g) - 1) ** 2 + (8 if g[-1] in _CN_TAIL else 0) + +    out: list[str] = [] +    for g, _ in sorted(grams.items(), key=lambda kv: (-_score(kv), -len(kv[0]))): +        if any(g in o or o in g for o in out): +            continue +        out.append(g) +        if len(out) >= 6: +            break +    return out + + +def _llm_meta(r: Metadata, text: str, notes: list) -> None: +    sys = "浣犳槸璁烘枃鍔╂墜銆傛牴鎹鏂囨彁鐐兼爣棰樸€佹憳瑕併€佸叧閿瘝銆傝緭鍑轰弗鏍?JSON銆? +    snippet = text[:3500] +    prompt = ( +        "姝ｆ枃鑺傞€夛細\n" + snippet + "\n\n" +        "杈撳嚭 JSON锛歕n{\"title\":\"...\",\"abstract\":\"...\",\"keywords\":[\"\",\"\"]}" +    ) +    raw = llm.chat(prompt, system=sys, temperature=0.5, max_tokens=1200) +    data = _strip_json_obj(raw) +    if not data: +        notes.append("LLM 杈撳嚭闈炲悎娉?JSON锛屼繚鐣欏惎鍙戝紡缁撴灉銆?) +        return +    if data.get("title"): +        r.title = str(data["title"]).strip() or r.title +    if data.get("abstract"): +        r.abstract = str(data["abstract"]).strip() or r.abstract +    if data.get("keywords"): +        r.keywords = [str(x) for x in data["keywords"] if x][:8] +    r.source = "LLM 鎻愮偧锛堥檮鍚彂寮忓熀绾匡級" + + +def _strip_json_obj(raw: str) -> dict: +    s = raw.strip() +    if s.startswith("```"): +        s = s.strip("`") +        if s.lower().startswith("json"): +            s = s[4:] +    i, j = s.find("{"), s.rfind("}") +    if i == -1 or j == -1 or j < i: +        return {} +    try: +        d = json.loads(s[i : j + 1]) +        return d if isinstance(d, dict) else {} +    except (ValueError, TypeError): +        return {} + + +def _persist(layout: Layout, paper_id: str, r: Metadata) -> Path: +    root = layout.project_dir(paper_id) / "research" +    root.mkdir(parents=True, exist_ok=True) +    p = root / "metadata.json" +    p.write_text(json.dumps(r.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8") +    md = root / "metadata.md" +    md.write_text(r.to_markdown(), encoding="utf-8") +    return p diff --git a/clawsgo_self/research/novelty.py b/clawsgo_self/research/novelty.py new file mode 100644 index 0000000..f03e42a --- /dev/null +++ b/clawsgo_self/research/novelty.py @@ -0,0 +1,217 @@ +"""鍒涙柊鎬ф鏌ワ紙novelty锛夛細浠庤鏂囨爣棰?鎽樿/姝ｆ枃鎶藉叧閿煭璇紝妫€绱㈡渶鐩镐技宸叉湁宸ヤ綔锛?+鍒嗘瀽閲嶅彔骞剁粰鍑哄€欓€夊樊寮傜偣锛屼緵浣滆€呭畾浣?contribution 涓庣浉鍏崇爺绌躲€?+ +澶嶇敤 lit.search_openalex锛堝厤 key锛岀绾垮洖閫€妯℃澘锛夈€?+""" + +from __future__ import annotations + +import json +import re +from dataclasses import dataclass, field + +from clawsgo_self.core import Layout +from clawsgo_self.research import lit + + +@dataclass +class NoveltyResult: +    ok: bool +    paper_id: str = "" +    title: str = "" +    abstract: str = "" +    phrases: list = field(default_factory=list) +    similar_papers: list = field(default_factory=list) +    overlapping_terms: list = field(default_factory=list) +    differentiators: list = field(default_factory=list) +    notes: list = field(default_factory=list) +    error: str = "" +    offline: bool = False + +    def to_dict(self) -> dict: +        return { +            "ok": self.ok, "paper_id": self.paper_id, "title": self.title, +            "abstract": self.abstract, "phrases": self.phrases, +            "similar_papers": self.similar_papers, +            "overlapping_terms": self.overlapping_terms, +            "differentiators": self.differentiators, +            "notes": self.notes, "error": self.error, "offline": self.offline, +        } + +    def to_markdown(self) -> str: +        def bullet(xs): +            return "\n".join(f"- {x}" for x in xs) if xs else "- 锛堝緟琛ュ厖锛岃€冭檻鑱氱劍鏇村鏂规硶/鍦烘櫙宸紓锛? + +        pubs = [] +        for p in self.similar_papers: +            score = p.get("score", 0) +            pubs.append( +                f"- 閲嶅彔 {score*100:.0f}% 鈥?[{p.get('year','?')}] {p.get('title','')} " +                f"({p.get('venue','')}, 琚紩{p.get('cited_by',0)}) {p.get('doi') or ''}" +            ) +        pubs_text = "\n".join(pubs) if pubs else "- 锛堟殏鏃犳绱㈠埌鐩镐技宸ヤ綔锛屽彲鑳界綉缁滅绾挎垨鍏抽敭璇嶈繃鏂帮級" +        return "\n\n".join([ +            f"# 鍒涙柊鎬ф鏌ワ細{self.paper_id}", +            f"## 璁烘枃淇℃伅\n- 鏍囬锛歿self.title or '锛堢己鐪侊級'}\n- 鎽樿锛歿(self.abstract or '锛堢己鐪侊級')[:300]}", +            f"## 鍏抽敭鐭\n{bullet(self.phrases)}", +            f"## 鐩镐技宸叉湁宸ヤ綔\n{pubs_text}", +            f"## 閲嶅彔鏈\n{bullet(self.overlapping_terms)}", +            f"## 鍊欓€夊樊寮傜偣\n{bullet(self.differentiators)}", +        ]) + + +# ---------- 涓诲嚱鏁?---------- + +def _paper_text(layout: Layout, paper_id: str) -> tuple[str, str]: +    """鍙栬鏂囨爣棰?鎽樿锛氫紭鍏?metadata.json锛屽洖閫€ doc.md銆?"" +    title, abstract = "", "" +    meta = layout.project_dir(paper_id) / "research" / "metadata.json" +    if meta.exists(): +        try: +            data = json.loads(meta.read_text(encoding="utf-8")) +            title = data.get("title") or "" +            abstract = data.get("abstract") or data.get("summary") or "" +        except (OSError, ValueError): +            pass +    if not title: +        doc = layout.project_dir(paper_id) / "doc.md" +        if doc.exists(): +            try: +                txt = doc.read_text(encoding="utf-8") +            except OSError: +                txt = "" +            m = re.search(r"^#\s+(.+)$", txt, re.M) +            if m: +                title = m.group(1).strip() +            if not abstract: +                body = re.sub(r"^#.*$", "", txt, flags=re.M)[:1200] +                abstract = body.strip() +    return title, abstract + + +_CONTENT_WORDS = { +    "妯″瀷", "鏂规硶", "妗嗘灦", "绠楁硶", "缃戠粶", "閲忓寲", "鍓灊", "钂搁", "鎺ㄧ悊", +    "瀛︿範", "浼樺寲", "璁粌", "璇嗗埆", "鐢熸垚", "澧炲己", "妫€绱?, "瀵归綈", "绋€鐤?, +    "杈圭紭", "绔晶", "鍗忓悓", "娣峰悎", "鍙В閲?, "娉涘寲", "椴佹", "娉ㄦ剰鍔?, +    "缂栫爜鍣?, "瑙ｇ爜鍣?, "transformer", "bert", "gpt", "llm", "澶фā鍨?, +} + + +def _extract_phrases(title: str, abstract: str) -> list[str]: +    src = (title + " " + abstract)[:2000] +    toks = re.split(r"[\s,锛屻€?锛涖€?锛?)锛堬級\[\]{}<>\"'鈥溾€濃€樷€橽-鈥?\\]+", src) +    phrases: list[str] = [] +    seen: set[str] = set() +    for t in toks: +        t = t.strip().strip(".") +        if not t or len(t) < 4: +            continue +        low = t.lower() +        if low in seen or low in _CONTENT_WORDS: +            continue +        seen.add(low) +        phrases.append(t) +    return phrases[:8] + + +def _tokens(s: str) -> set[str]: +    return {t.lower() for t in re.split(r"[\W_]+", s) if len(t) > 1} + + +def _overlap(peer_title: str, title: str, abstract: str) -> float: +    base = _tokens(title + " " + abstract) +    if not base: +        return 0.0 +    n = sum(1 for t in base if t in peer_title.lower()) +    return n / len(base) + + +def _common_terms(title: str, abstract: str, scored: list[dict]) -> list[str]: +    mine = _tokens(title + " " + abstract) +    agg: set[str] = set() +    for p in scored: +        body = (p.get("title") or "") + " " + (p.get("abstract") or "") +        agg |= _tokens(body) & mine +    terms = sorted(agg, key=len, reverse=True)[:10] +    return terms or ["锛堟湭妫€鍑烘槑鏄鹃噸鍙犱富棰樿瘝锛?] + + +def _build_differentiators(r: NoveltyResult) -> list[str]: +    if not r.similar_papers: +        return [ +            "鏈楂樺害鐩镐技宸ヤ綔锛氬彲浣滀负绌虹櫧鐐瑰垏鍏ワ紝寤鸿鍦?related work 涓０鏄庨鍙戞€с€?, +            "鑻ヤ负缁艰堪鎬ч€夐锛屽缓璁鏄庢湰宸ヤ綔瑕嗙洊鑼冨洿涓庡凡鏈夌患杩扮殑宸紓锛堟洿缁嗙矑搴?鏇存柊鏂囩尞锛夈€?, +        ] +    top = r.similar_papers[0] +    tname = (top.get("title") or "")[:60] +    lead = r.title or (r.phrases[0] if r.phrases else "鏈富棰?) +    return [ +        f"鐩告瘮浠ｈ〃宸ヤ綔銆寋tname}銆嶏細鍏惰仛鐒?{_focus_of(top)}锛涙湰鏂囦晶閲?{lead}锛? +        "鍙己璋冭祫婧愬彈闄?鏁堢巼-绮惧害鑱斿悎浼樺寲绛変笉鍚屽垏鍏ョ偣銆?, +        "寤鸿鍦ㄦ憳瑕佷笌寮曡█鏄庣‘鍒楀嚭涓庝笂杩板伐浣滅殑 2-3 鐐瑰疄璐ㄥ樊寮傦紙鏁版嵁瑙勬ā銆佹柟娉曟満鍒躲€佽瘎娴嬪彛寰勶級銆?, +        "琛ュ仛瀵圭収瀹為獙锛氬湪鐩稿悓鍩哄噯涓婁笌 Top 鐩镐技宸ヤ綔瀵规瘮锛岄噺鍖栨敹鐩婁互鏀拺 novelty 澹版槑銆?, +    ] + + +def _focus_of(p: dict) -> str: +    abs_ = (p.get("abstract") or "")[:80].strip() +    return abs_ or (p.get("title") or "鐩稿叧鏂瑰悜")[:40] + + +def check_novelty( +    *, +    paper_id: str, +    layout: Layout, +    limit: int = 8, +    sources: list[str] | None = None, +) -> NoveltyResult: +    """鍒涙柊鎬ф鏌ワ細妫€绱㈢浉浼煎伐浣滃苟缁欏嚭宸紓鐐广€?"" +    r = NoveltyResult(ok=False, paper_id=paper_id) +    title, abstract = _paper_text(layout, paper_id) +    if not (title or abstract): +        r.error = f"椤圭洰 {paper_id} 娌℃湁鍙埄鐢ㄧ殑鏍囬/鎽樿鍐呭锛堝啓 doc.md 鎴栧厛璺?auto_title_abstract锛夈€? +        return r +    r.title, r.abstract = title, abstract +    phrases = _extract_phrases(title, abstract) +    r.phrases = phrases + +    from clawsgo_self.science.api import cross_lookup +    if sources: +        papers = cross_lookup(" ".join(phrases), databases=sources, limit=limit) +    else: +        queries = [title] if title else [abstract[:120]] +        if len(phrases) >= 3: +            queries.append(" ".join(phrases[:4])) +        if len(phrases) >= 5: +            queries.append(" ".join(phrases[4:7])) + +        papers = [] +        for q in queries[:3]: +            hits = lit.search_openalex(q, limit=limit) +            papers.extend(hits) +    papers = lit.dedupe(papers) +    if not papers: +        r.offline = True +        r.notes.append("OpenAlex 鏃犵粨鏋滐紙绂荤嚎鎴栧叧閿瘝杩囨柊锛夛紝宸紓鐐圭敤鍚彂寮忔ā鏉裤€?) +    else: +        scored = [] +        for p in papers: +            p["score"] = round(min(1.0, _overlap(p.get("title", "") or "", title, abstract) + 0.15), 3) +            scored.append(p) +        scored.sort(key=lambda p: p.get("score", 0), reverse=True) +        r.similar_papers = scored[:limit] +        r.overlapping_terms = _common_terms(title, abstract, scored) + +    r.differentiators = _build_differentiators(r) +    _persist(layout, paper_id, r) +    r.ok = True +    return r + + +def _persist(layout: Layout, paper_id: str, r: NoveltyResult): +    root = layout.project_dir(paper_id) / "research" +    root.mkdir(parents=True, exist_ok=True) +    (root / "novelty.json").write_text( +        json.dumps(r.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8" +    ) +    (root / "novelty.md").write_text(r.to_markdown(), encoding="utf-8") \ No newline at end of file diff --git a/clawsgo_self/research/plan.py b/clawsgo_self/research/plan.py new file mode 100644 index 0000000..e8fa286 --- /dev/null +++ b/clawsgo_self/research/plan.py @@ -0,0 +1,220 @@ +"""鐮旂┒璁″垝涔︼細鎶婇€夐鎵╁睍鎴愪竴浠藉彲鎵ц鐨勫畬鏁寸爺绌惰鍒掞紙鐮旂┒璁″垝涔︼級銆?+ +瀵归綈 RESEARCH_PLANNING锛氫骇鍑?+  - 閫夐涓庢爣棰?+  - 鐮旂┒闂锛圧Q锛変笌鍋囪 +  - 鐩爣涓庤础鐚?+  - 鏂规硶璺嚎 +  - 鏁版嵁闆嗕笌鍩虹嚎 +  - 璇勪及鎸囨爣 +  - 娑堣瀺 +  - 閲岀▼纰戜笌杩涘害琛?+  - 椋庨櫓涓庨鏈熺粨鏋?+缁熶竴钀界洏 projects/{paper_id}/research/research_plan.json + markdown 鐗囨銆?+鏃?LLM 鏃剁‘瀹氭€у洖閫€锛堝彲澶嶇敤 ideate/experiment plan 鐨勪骇鐗╋級銆?+""" + +from __future__ import annotations + +import json +from dataclasses import dataclass, field +from pathlib import Path + +from clawsgo_self.core import Layout +from clawsgo_self.core import model as llm + + +@dataclass +class ResearchPlan: +    ok: bool +    title: str = "" +    topic: str = "" +    question: str = "" +    hypotheses: list = field(default_factory=list) +    objectives: list = field(default_factory=list) +    contributions: list = field(default_factory=list) +    methodology: list = field(default_factory=list) +    datasets: list = field(default_factory=list) +    baselines: list = field(default_factory=list) +    metrics: list = field(default_factory=list) +    ablation: list = field(default_factory=list) +    milestones: list = field(default_factory=list) +    risks: list = field(default_factory=list) +    expected: list = field(default_factory=list) +    compute: str = "" +    notes: list = field(default_factory=list) +    error: str = "" +    llm_used: bool = False + +    def to_dict(self) -> dict: +        return {k: getattr(self, k) for k in ( +            "ok", "title", "topic", "question", "hypotheses", "objectives", +            "contributions", "methodology", "datasets", "baselines", "metrics", +            "ablation", "milestones", "risks", "expected", "compute", +            "notes", "error", "llm_used", +        )} + +    def to_markdown(self) -> str: +        def bullet(xs): +            return "\n".join(f"- {x}" for x in xs) if xs else "- 锛堝緟琛ュ厖锛? + +        mets = "\n".join( +            f"- {m if isinstance(m, str) else m.get('name', '')}" +            for m in self.metrics +        ) or "- 锛堝緟琛ュ厖锛? +        return "\n\n".join([ +            f"# 鐮旂┒璁″垝涔︼細{self.title or '鏈懡鍚?}", +            f"**鐮旂┒鏂瑰悜锛?* {self.topic or '鈥?}\n**鐮旂┒闂锛?* {self.question or '鈥?}", +            f"## 鍋囪\n{bullet(self.hypotheses)}", +            f"## 鐩爣\n{bullet(self.objectives)}", +            f"## 璐＄尞\n{bullet(self.contributions)}", +            f"## 鏂规硶璺嚎\n{bullet(self.methodology)}", +            f"## 鏁版嵁闆哱n{bullet(self.datasets)}", +            f"## 鍩虹嚎\n{bullet(self.baselines)}", +            f"## 璇勪及鎸囨爣\n{mets}", +            f"## 娑堣瀺\n{bullet(self.ablation)}", +            f"## 閲岀▼纰戜笌杩涘害\n{bullet(self.milestones)}", +            f"## 椋庨櫓\n{bullet(self.risks)}", +            f"## 棰勬湡缁撴灉\n{bullet(self.expected)}", +            f"## 璁＄畻璧勬簮\n{self.compute or '寰呰瘎浼?}", +        ]) + + +def _load_ideation(layout: Layout, paper_id: str) -> dict: +    p = layout.project_dir(paper_id) / "research" / "ideation.json" +    if p.exists(): +        try: +            return json.loads(p.read_text(encoding="utf-8")) +        except (OSError, ValueError): +            return {} +    return {} + + +def _load_plan(layout: Layout, paper_id: str) -> dict: +    p = layout.project_dir(paper_id) / "research" / "experiment_plan.json" +    if p.exists(): +        try: +            return json.loads(p.read_text(encoding="utf-8")) +        except (OSError, ValueError): +            return {} +    return {} + + +def research_plan( +    topic: str, +    *, +    paper_id: str, +    layout: Layout, +) -> ResearchPlan: +    r = ResearchPlan(ok=False, topic=topic) +    notes: list = [] +    ide = _load_ideation(layout, paper_id) +    ex = _load_plan(layout, paper_id) + +    # 鏍囬/闂鏉ユ簮锛氫紭鍏堝凡瀛樺湪鐨?ideation/experiment plan +    cands = ide.get("candidates") or [] +    title = "" +    if cands: +        title = cands[0].get("title", "") if isinstance(cands[0], dict) else str(cands[0]) +    r.title = title or ex.get("title") or topic +    r.question = ( +        (ide.get("questions") or [""])[0] +        or ex.get("question") +        or f"閽堝銆寋topic}銆嶏紝褰撳墠鏂规硶鐨勭摱棰堜笌鏇翠紭鏂规鏄粈涔堬紵" +    ) + +    if llm.configured(): +        try: +            _llm_plan(r, topic, notes) +            r.llm_used = True +        except RuntimeError as e: +            notes.append(f"LLM 璁″垝涔︿笉鍙敤锛屽洖閫€妯℃澘锛歿e}") + +    if not r.hypotheses: +        _template_plan(r, ide, ex, notes) + +    r.notes = notes +    r.ok = True +    _persist(layout, paper_id, r) +    return r + + +def _llm_plan(r: ResearchPlan, topic: str, notes: list) -> None: +    sys = "浣犳槸璧勬繁绉戠爺椤圭洰瑙勫垝鑰呫€傚熀浜庝富棰樿緭鍑轰竴浠藉畬鏁寸爺绌惰鍒掍功銆傝緭鍑轰弗鏍?JSON锛屼笉缂栭€犳暟鎹€? +    prompt = ( +        f"鐮旂┒