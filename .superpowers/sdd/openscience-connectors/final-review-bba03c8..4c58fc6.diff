涘綊鍥? in r.keywords + + +def test_auto_title_abstract_no_h1_fallback(tmp_path): +    """鏃犱竴绾ф爣棰樻椂锛氭爣棰樺洖閫€涓烘憳瑕侀鍙ワ紱鏃犲叧閿瘝琛屾椂锛氫腑鏂?n-gram 鍥為€€銆?+    """ +    from clawsgo_self.research.extract import auto_title_abstract + +    layout = _layout(tmp_path) +    body = ( +        "## 鎽樿\n鏈伐浣滄彁鍑轰竴绉嶉潰鍚戣竟缂樿澶囩殑澶ц瑷€妯″瀷杞婚噺鍖栨帹鐞嗗姞閫熸柟娉曘€? +        "璇ユ柟娉曠粨鍚堢粨鏋勫寲鍓灊涓庣煡璇嗚捀棣忥紝鍦ㄨ竟缂樿澶囦笂鏄捐憲闄嶄綆鎺ㄧ悊寤惰繜銆俓n\n" +        "## 寮曡█\n杈圭紭璁惧涓婂ぇ璇█妯″瀷鎺ㄧ悊寤惰繜杈冮珮锛岀浉鍏崇爺绌惰嚧鍔涗簬杞婚噺鍖栭儴缃层€? +        "缁撴瀯鍖栧壀鏋濅笌鐭ヨ瘑钂搁鏄袱绉嶄富娴佸帇缂╃瓥鐣ャ€? +    ) +    _write_doc(layout, "p_meta2", body) +    r = auto_title_abstract(paper_id="p_meta2", layout=layout) +    assert r.ok is True +    # 鏍囬鍥為€€锛氫粠鎽樿棣栧彞鐢熸垚鍊欓€夛紝鍓旈櫎銆屾湰宸ヤ綔鎻愬嚭涓€绉嶃€嶅墠缂€ +    assert r.title and "闈㈠悜杈圭紭璁惧" in r.title +    # 涓枃鍏抽敭璇嶅洖閫€锛氬嚭鐜版湁淇℃伅閲忕殑涓婚璇嶏紙闈炶嫳鏂囪瘝鍏滃簳锛?+    joined = "".join(r.keywords) +    assert any(k in joined for k in ("澶ц瑷€妯″瀷", "鍓灊", "钂搁", "杈圭紭璁惧", "鎺ㄧ悊")) +    assert not r.title.startswith(("鏈伐浣?, "鏈枃", "鎻愬嚭")) + + +def test_peer_review_scores_and_recommendation(tmp_path): +    from clawsgo_self.research.review import peer_review + +    layout = _layout(tmp_path) +    body = ( +        "# 鏍囬\n\n## 鎽樿\n鎽樿鍐呭瓒冲闀裤€? * 2 + +        "\n\n## 寮曡█\n motivation 涓庤儗鏅粙缁嶆钀藉唴瀹广€? * 3 + +        "\n\n| 鏂规硶 | 绮惧害 |\n| --- | --- |\n| 鍩虹嚎 | 0.9 |\n| 鏈枃 | 0.95 |\n" + +        "\n\n![fig1](x.png)\n\n[1] arxiv:1234.5678" +    ) +    _write_doc(layout, "p_pr", body) +    r = peer_review(paper_id="p_pr", layout=layout) +    assert r.ok is True +    assert {"novelty", "rigor", "clarity", "soundness"} <= set(r.scores) +    assert r.recommendation in ("Accept (with minor)", "Minor Revision", "Major Revision", "Reject") +    assert (layout.project_dir("p_pr") / "research" / "peer_review.json").exists() + + +def test_paper_polish_completeness_flags_missing(tmp_path): +    from clawsgo_self.research.polish import paper_polish + +    layout = _layout(tmp_path) +    # 鍙啓寮曡█锛岀己缁撴灉/缁撹/寮曠敤 +    _write_doc(layout, "p_pol", "# 寮曡█\n鍐呭鍐呭鍐呭銆?) +    r = paper_polish(paper_id="p_pol", layout=layout, mode="completeness") +    assert r.ok is True +    assert r.issues and isinstance(r.score, float) +    assert any("缁撴灉" in i or "缁撹" in i or "鍙傝€冩枃鐚? in i for i in r.issues) + + +def test_paper_polish_empty_error(tmp_path): +    from clawsgo_self.research.polish import paper_polish + +    layout = _layout(tmp_path) +    r = paper_polish(paper_id="ghost_pol", layout=layout) +    assert r.ok is False +    assert "灏氭棤姝ｆ枃" in r.error + + +def test_peer_review_empty_error(tmp_path): +    from clawsgo_self.research.review import peer_review + +    layout = _layout(tmp_path) +    r = peer_review(paper_id="ghost_pr", layout=layout) +    assert r.ok is False +    assert "灏氭棤姝ｆ枃" in r.error diff --git a/tests/test_science_api.py b/tests/test_science_api.py new file mode 100644 index 0000000..902fbcc --- /dev/null +++ b/tests/test_science_api.py @@ -0,0 +1,90 @@ +import pytest +from clawsgo_self.science.connector import Connector, ConnectorRegistry +from clawsgo_self.science import api + + +def _reg() -> ConnectorRegistry: +    reg = ConnectorRegistry() +    reg.register(Connector(id="openalex", name="OpenAlex", domain="literature", +                            description="OpenAlex works", search=lambda q, n: [ +                                {"title": "T", "year": 2024, "doi": "10/x", +                                 "url": "http://x", "venue": "V", "authors": ["A"], +                                 "cited_by": 5, "abstract": "ab"}])) +    reg.register(Connector(id="uniprot", name="UniProt", domain="proteins", +                            description="UniProt KB", search=lambda q, n: [ +                                {"id": "P12345", "title": "Protein X", +                                 "summary": "desc", "url": "http://u"}])) +    reg.register(Connector(id="chembl", name="ChEMBL", domain="chemistry", +                            description="ChEMBL", search=lambda q, n: [])) +    return reg + + +def test_science_list_dbs_all(mon