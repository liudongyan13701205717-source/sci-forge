ation: +        r.ablation = ex.get("ablation") or ["鍘婚櫎鏍稿績缁勪欢", "鍏抽敭瓒呭弬鏁忔劅鎬?] +    if not r.milestones: +        r.milestones = ["M1 鏂囩尞涓庨€夐鏀舵暃", "M2 鍘熷瀷涓庡熀绾垮鐜?, "M3 瀹為獙涓庢秷铻?, "M4 鎾板啓涓庝氦浠?] +    if not r.risks: +        r.risks = ["鏁版嵁/鏍囩绋€缂?, "鍩虹嚎澶嶇幇闅惧害楂樹簬棰勬湡", "鎸囨爣鎻愬崌涓嶆樉钁楋紙鏃堕棿绐楀唴锛?] +    if not r.expected: +        r.expected = ex.get("expected") or ["鐩稿鍩虹嚎鏈夊彲閲忓寲鎻愬崌锛屼笖寮€閿€鍙帶"] +    if not r.compute: +        r.compute = ex.get("compute") or "鍗曞崱 CPU/GPU 鍗冲彲瀹屾垚灏忚妯￠獙璇併€? +    notes.append("鏃?LLM锛屼娇鐢ㄧ‘瀹氭€фā鏉跨敓鎴愮爺绌惰鍒掍功锛堝洖濉?ideation/experiment_plan锛夈€?) + + +def _strip_json_obj(raw: str) -> dict: +    s = raw.strip() +    if s.startswith("```"): +        s = s.strip("`") +        if s.lower().startswith("json"): +            s = s[4:] +    i, j = s.find("{"), s.rfind("}") +    if i == -1 or j == -1 or j < i: +        return {} +    try: +        d = json.loads(s[i : j + 1]) +        return d if isinstance(d, dict) else {} +    except (ValueError, TypeError): +        return {} + + +def _persist(layout: Layout, paper_id: str, r: ResearchPlan) -> Path: +    root = layout.project_dir(paper_id) / "research" +    root.mkdir(parents=True, exist_ok=True) +    p = root / "research_plan.json" +    p.write_text(json.dumps(r.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8") +    md = root / "research_plan.md" +    md.write_text(r.to_markdown(), encoding="utf-8") +    return p diff --git a/clawsgo_self/research/polish.py b/clawsgo_self/research/polish.py new file mode 100644 index 0000000..8244a4c --- /dev/null +++ b/clawsgo_self/research/polish.py @@ -0,0 +1,194 @@ +"""璁烘枃娑﹁壊涓庢鏌ワ紙paper_polish锛夛細瀵瑰凡鏈夋鏂囧仛涓夌被璐ㄩ噺妫€鏌ュ苟浜у嚭寤鸿銆?+ +mode: +  - completeness锛氬畬鏁存€ф鏌ワ紙缂哄摢浜涘叧閿珷鑺?鍥捐〃/寮曠敤锛?+  - consistency锛氫竴鑷存€ф鏌ワ紙鏈/缂栧彿/鍏紡/鍗曚綅閲嶅鎴栫煕鐩撅級 +  - grammar锛氳瑷€娑﹁壊锛堟儻鐢ㄨ銆佸啑浣欍€佽鍔ㄨ鎬佺瓑鎻愮ず锛?+鏃?LLM 鏃跺叏閮ㄥ熀浜庤鍒欏仛纭畾鎬ф鏌ワ紱鍙?LLM 澧炲己娑﹁壊绀轰緥銆?+钀界洏 projects/{paper_id}/research/polish_{mode}.json + md銆?+""" + +from __future__ import annotations + +import json +import re +from dataclasses import dataclass, field +from pathlib import Path + +from clawsgo_self.core import Layout +from clawsgo_self.core import model as llm +from clawsgo_self.write.doc import DocStore + +_SECTIONS = ["鎽樿", "寮曡█", "鐮旂┒闂", "寤烘ā", "姹傝В", "瀹為獙", "缁撴灉", "缁撹", +             "abstract", "introduction", "method", "experiments", "results", "conclusion"] +_MODES = ("completeness", "consistency", "grammar") + + +@dataclass +class PolishResult: +    ok: bool +    paper_id: str = "" +    mode: str = "" +    score: float = 0.0 +    issues: list = field(default_factory=list) +    rewritten: list = field(default_factory=list) +    notes: list = field(default_factory=list) +    error: str = "" +    llm_used: bool = False + +    def to_dict(self) -> dict: +        return {k: getattr(self, k) for k in ( +            "ok", "paper_id", "mode", "score", "issues", "rewritten", +            "notes", "error", "llm_used", +        )} + +    def to_markdown(self) -> str: +        def bullet(xs): +            return "\n".join(f"- {x}" for x in xs) if xs else "- 锛堟殏鏃狅級" + +        return "\n\n".join([ +            f"# 璁烘枃妫€鏌ワ細{self.mode}锛坽self.paper_id}锛?, +            f"**璐ㄩ噺鍒嗭細** {self.score}/10", +            f"## 闂娓呭崟\n{bullet(self.issues)}", +            f"## 娑﹁壊绀轰緥\n{bullet(self.rewritten)}", +        ]) + + +def _read_doc(layout: Layout, paper_id: str) -> str: +    doc = DocStore(layout, paper_id) +    parts = [] +    if doc.doc_md.exists(): +        parts.append(doc.doc_md.read_text(encoding="utf-8")) +    else: +        for f in sorted(doc.sections_dir.glob("*.md")): +            parts.append(f.read_text(encoding="utf-8")) +    return "\n".join(parts) + + +def paper_polish( +    *, +    paper_id: str, +    layout: Layout, +    mode: str = "completeness", +) -> PolishResult: +    mode = mode if mode in _MODES else "completeness" +    r = PolishResult(ok=False, paper_id=paper_id, mode=mode) +    notes: list = [] +    text = _read_doc(layout, paper_id) +    if not text.strip(): +        r.error = f"椤圭洰 {paper_id} 灏氭棤姝ｆ枃锛岃鍏堝啓鍏ュ唴瀹广€? +        r.ok = False +        return r + +    issues, score = _check(text, mode) +    r.issues = issues +    r.score = score + +    if llm.configured() and mode == "grammar": +        try: +            _llm_polish(r, text, notes) +            r.llm_used = True +        except RuntimeError as e: +            notes.append(f"LLM 娑﹁壊涓嶅彲鐢紝淇濈暀瑙勫垯缁撴灉锛歿e}") + +    r.notes = notes +    r.ok = True +    _persist(layout, paper_id, r) +    return r + + +def _check(text: str, mode: str) -> tuple[list, float]: +    issues: list = [] +    if mode == "completeness": +        missing = [s for s in ("鎽樿", "寮曡█", "瀹為獙", "缁撴灉", "缁撹") +                   if not re.search(rf"(?i)#+\s*.*{s}", text)] +        issues += [f"缂哄皯鍏抽敭绔犺妭锛歿m}" for m in missing] +        if text.count("|") > 3 and text.count("|") // 10 < 1: +            issues.append("瀛樺湪琛ㄦ牸鏍囪浣嗙粨鏋勫彲鑳戒笉瀹屾暣锛岃鏍稿鍒楀榻愩€?) +        if not re.search(r"(?i)\[\d+\]|\bdoi\b|\barxiv\b", text): +            issues.append("缂哄皯瑙勮寖鍙傝€冩枃鐚紩鐢ㄣ€?) +        if text.count("寰呰ˉ鍏?) > 0: +            issues.append(f"瀛樺湪 {text.count('寰呰ˉ鍏?)} 澶勫崰浣嶏紙寰呰ˉ鍏咃級鏈浛鎹€?) +        if text.count("![" ) < 1 and not re.search(r"\\includegraphics|\\begin\{figure\}", text): +            issues.append("缂哄皯鍥撅紙鍙敤鏀舵暃鏇茬嚎/瀵规瘮鍥?妗嗘灦鍥撅級銆?) + +    elif mode == "consistency": +        # 妫€鏌ュ叕寮忕紪鍙烽噸澶嶃€佹湳璇彛寰勪笉涓€銆佸崰浣嶇娈嬬暀 +        eqs = re.findall(r"\(\s*(\d+)\s*\)", text) +        dup = {n for n in set(eqs) if eqs.count(n) > 1} +        if dup: +            issues.append(f"鍏紡/缂栧彿閲嶅浣跨敤锛歿sorted(dup, key=int)[:8]}锛岃缁熶竴缂栧彿銆?) +        if "{" in text and re.search(r"\{\{\s*[a-zA-Z_]+\s*\}\}", text): +            issues.append("瀛樺湪鏈浛鎹㈢殑妯℃澘鍗犱綅绗?{{...}}銆?) +        if re.search(r"(?i)\byour model\b|your approach\b|\bTODO\b", text): +            issues.append("瀛樺湪鐣欑粰璇昏€呯殑鎸囦唬锛坹our model/TODO锛夛紝搴旀敼涓虹‘瀹氬悕绉般€?) +        if "鍥?1" in text and "鍥?1" not in text and re.search(r"鍥綷s+1", text): +            pass +        if not issues: +    