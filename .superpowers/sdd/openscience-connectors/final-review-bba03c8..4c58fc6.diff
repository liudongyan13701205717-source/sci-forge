ct = field(default_factory=dict) +    notes: list = field(default_factory=list) +    error: str = "" +    llm_used: bool = False + +    def to_dict(self) -> dict: +        return {k: getattr(self, k) for k in ( +            "ok", "paper_id", "scores", "recommendation", "strengths", +            "weaknesses", "modifications", "stats", "notes", "error", "llm_used", +        )} + +    def to_markdown(self) -> str: +        def bullet(xs): +            return "\n".join(f"- {x}" for x in xs) if xs else "- 锛堝緟琛ュ厖锛? + +        sc = "\n".join(f"- {k}: {v}/10" for k, v in self.scores.items()) or "- 锛堝緟璇勶級" +        return "\n\n".join([ +            f"# 鍚岃璇勫鎰忚锛坽self.paper_id}锛?, +            f"**鎺ㄨ崘锛?* {self.recommendation}", +            f"## 璇勫垎\n{sc}", +            f"**缁熻锛?* 姝ｆ枃 {self.stats.get('chars',0)} 瀛楋紝瑕嗙洊绔犺妭 " +            f"{'銆?.join(self.stats.get('sections_found',[])) or '鈥?}锛屽浘琛?" +            f"{self.stats.get('tables',0)} 琛?/ {self.stats.get('figures',0)} 鍥?, +            f"## 浼樼偣\n{bullet(self.strengths)}", +            f"## 缂虹偣 / 鍏虫敞鐐筡n{bullet(self.weaknesses)}", +            f"## 淇敼寤鸿\n{bullet(self.modifications)}", +        ]) + + +def _read_doc(layout: Layout, paper_id: str) -> str: +    doc = DocStore(layout, paper_id) +    parts = [] +    if doc.doc_md.exists(): +        parts.append(doc.doc_md.read_text(encoding="utf-8")) +    else: +        for f in sorted(doc.sections_dir.glob("*.md")): +            parts.append(f.read_text(encoding="utf-8")) +    return "\n".join(parts) + + +def peer_review( +    *, +    paper_id: str, +    layout: Layout, +) -> PeerReview: +    r = PeerReview(ok=False, paper_id=paper_id) +    notes: list = [] +    text = _read_doc(layout, paper_id) +    if not text.strip(): +        r.error = f"椤圭洰 {paper_id} 灏氭棤姝ｆ枃锛岃鍏堢敤 write_section / agent 鍐欏叆鍐呭銆? +        r.ok = False +        return r + +    stats, found = _stats(text) + +    scoring = _template_scoring(text, stats, found) +    r.scores = scoring["scores"] +    r.recommendation = scoring["recommendation"] +    r.strengths = scoring["strengths"] +    r.weaknesses = scoring["weaknesses"] +    r.modifications = scoring["modifications"] +    r.stats = stats + +    if llm.configured(): +        try: +            _llm_review(r, text, notes) +            r.llm_used = True +        except RuntimeError as e: +            notes.append(f"LLM 璇勫涓嶅彲鐢紝淇濈暀妯℃澘璇勫垎锛歿e}") + +    r.notes = notes +    r.ok = True +    _persist(layout, paper_id, r) +    return r + + +def _stats(text: str) -> tuple[dict, list]: +    text_nl = re.sub(r"\s+", " ", text) +    chars = len(text_nl.replace(" ", "")) +    tables = text.count("|") // 10 if text.count("|") > 3 else 0 +    figures = len(re.findall(r"!\[|\\includegraphics|\\begin\{figure\}", text)) +    found = [s for s in _SECTIONS if re.search(rf"(?i)(#+\s*{s}|##\s*.*{s})", text)] +    return { +        "chars": chars, +        "tables": tables, +        "figures": figures, +        "blockquote_placeholder": text.count("寰呰ˉ鍏?), +        "has_formula": bool(re.search(r"\$|\\frac|\\sum|\\nabla", text)), +    }, found + + +def _template_scoring(text: str, stats: dict, found: list) -> dict: +    placeholders = stats.get("blockquote_placeholder", 0) +    has_formula = stats.get("has_formula", False) +    tables = stats.get("tables", 0) +    figures = stats.get("figures", 0) + +    # novelty: 鏈夋柟娉曟帹瀵?鍏紡缁欏熀纭€鍒嗭紝缂鸿儗鏅啀鎵?+    novelty = 6.0 +    if has_formula: +        novelty += 0.5 +    if placeholders: +        novelty -= 0.5 + +    rigor = 6.0 +    rigor += 0.5 if tables else 0 +    rigor += 0.5 if figures else 0 +    rigor -= 0.5 if "鍙傝€冩枃鐚? not in [f for f in found] or not re.search(r"(?i)\[\d+\]|\bdoi\b|\barxiv", text) else 0 +    rigor -= 0.5 if placeholders else 0 + +    clarity = 5.5 +    if stat := stats.get("chars", 0): +        clarity += 1.0 if stat > 2000 else 0.5 +    clarity -= 0.5 * placeholders + +    soundness = 6.0 +    if tables and figures: +        soundness += 1.0 +    elif figures: +        soundness += 0.5 +    soundness -= 0.5 if placeholders else 0 + +    def clip(x): +        return round(max(1.0, min(10.0, x)), 1) + +    scores = {"novelty": clip(novelty), "rigor": clip(rigor), +              "clarity": clip(clarity), "soundness": clip(soundness)} +    avg = sum(scores.values()) / 4 +    if placeholders: +        rec = "Major Revision" +    elif avg >= 7.5: +        rec = "Accept (with minor)" +    elif avg >= 6.0: +        rec = "Minor Revision" +    elif avg >= 4.5: +        rec = "Major Revision" +    else: +        rec = "Reject" + +    strengths = [] +    weaknesses = [] +    modifications = [] +    if stats.get("has_formula"): +        strengths.append("鍚舰寮忓寲寤烘ā/鍏紡锛屾柟娉曡鏄庣‘瀹氫箟銆?) +    if tables: +        strengths.append(f"鎻愪緵浜?{tables} 寮犲姣?鏁版嵁琛紝鏀拺璁鸿瘉銆?) +    if figures: +        strengths.append(f"鍚?{figures} 澶勫浘锛岀洿瑙傚憟鐜扮粨鏋溿€?) +    if len(found) >= 5: +        strengths.append("绔犺妭缁撴瀯鍩烘湰瀹屾暣锛岃鐩栦富绾裤€?) +    if not strengths: +        strengths.append("缁撴瀯瀹屾暣锛屽叿澶囪繘涓€姝ユ墦纾ㄥ熀纭€銆?) + +    if placeholders: +        weaknesses.append(f"瀛樺湪 {placeholders} 澶勫崰浣嶏紙寰呰ˉ鍏咃級锛岃€岄潪瀹屾暣琛ㄨ揪銆?) +        modifications.append("閫愮珷琛ュ叏鍗犱綅鍐呭涓哄畬鏁存钀姐€?) +    if figures == 0: +        weaknesses.append("缂哄皯鍥捐〃锛岀粨鏋滃憟鐜板彈闄愩€?) +        modifications.append("琛ュ厖鏀舵暃鏇茬嚎/瀵规瘮琛?娑堣瀺鍥俱€?) +    if not re.search(r"(?i)\[\d+\]|\bdoi\b|\barxiv\b", text): +        weaknesses.append("缂哄皯瑙勮寖鍙傝€冩枃鐚紩鐢ㄣ€?) +        modifications.append("琛ュ厖鏂囧唴寮曠敤涓庢枃鐚〃銆?) +    if not weaknesses: +        weaknesses.append("鏈鏄庢樉缂洪櫡锛屼粛寤鸿鍔犲己瀹為獙/鍒嗘瀽娣卞害銆?) +    if len(modifications) < 2: +        modifications.append("鍔犲己瀹為獙涓庢秷铻嶅垎鏋愶紝鏄庣‘瀵瑰熀绾垮鐩婄殑鏉ユ簮銆?) +    return {"scores": scores, "recommendation": rec, +            "strengths": strengths, "weaknesses": weaknesses, "modifications": modifications} + + +def _llm_review(r: PeerReview, text: str, notes: list) -> None: +    sys = "浣犳槸棰嗗煙鍐呰祫娣卞绋夸汉銆傚熀浜庤鏂囨鏂囩粰鍑虹粨鏋勫寲瀹＄鎰忚銆傝緭鍑轰弗鏍?JSON銆? +    snippet = text[:4000] +    prompt = ( +        "璁烘枃鐗囨锛堣妭閫夛級锛歕n" + snippet + "\n\n" +        "杈撳嚭 JSON锛歕n" +        "{\"scores\":{\"novelty\":0,\"rigor\":0,\"clarity\":0,\"soundness\":0},\n" +        " \"recommendation\":\"Accept|Minor|Major|Reject\",\n" +        " \"strengths\":[\"\"],\"weaknesses\":[\"\"],\"modifications\":[\"\"]}" +    ) +    raw = llm.chat(prompt, system=sys, temperature=0.5, max_tokens=1200) +    data = _strip_json_obj(raw) +    if not data: +        notes.append("LLM 杈撳嚭闈炲悎娉?JSON锛屼繚鐣欐ā鏉胯瘎鍒嗐€?) +        return +    sc = data.get("scores") or {} +    merged = dict(r.scores) +    for k in ("novelty", "rigor", "clarity", "soundness"): +        if isinstance(sc.get(k), (int, float)): +            merged[k] = round(max(1.0, min(10.0, float(sc[k]))), 1) +    r.scores = merged +    r.recommendation = data.get("recommendation") or r.recommendation +    if data.get("strengths"): +        r.strengths = [str(x) for x in data["strengths"]][:4] +    if data.get("weaknesses"): +        r.weaknesses = [str(x) for x in data["weaknesses"]][:4] +    if data.get("modifications"): +        r.modifications = [str(x) for x in data["modifications"]][:4] + + +def _strip_json_obj(raw: str) -> dict: +    s = raw.strip() +    if s.startswith("```"): +        s = s.strip("`") +        if s.lower().startswith("json"): +            s = s[4:] +    i, j = s.find("{"), s.rfind("}") +    if i == -1 or j == -1 or j < i: +        return {} +    try: +        d = json.loads(s[i : j + 1]) +        return d if isinstance(d, dict) else {} +    except (ValueError, TypeError): +        return {} + + +def _persist(layout: Layout, paper_id: str, r: PeerReview) -> Path: +    root = layout.project_dir(paper_id) / "research" +    root.mkdir(parents=True, exist_ok=True) +    p = root / "peer_review.json" +    p.write_text(json.dumps(r.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8") +    md = root / "peer_review.md" +    md.write_text(r.to_markdown(), encoding="utf-8") +    return p \ No newline at end of file diff --git a/clawsgo_self/research/stats.py b/clawsgo_self/research/stats.py new file mode 100644 index 0000000..36a881c --- /dev/null +++ b/clawsgo_self/research/stats.py @@ -0,0 +1,192 @@ +"""鏄捐憲鎬ф楠岋細绾爣鍑嗗簱瀹炵幇鐨?Welch t 妫€楠屼笌 Mann-Whitney U 妫€楠屻€?+ +鐢ㄤ簬鎶娿€屾湰鏂?vs 鍩虹嚎銆嶇殑澶氭杩愯鎸囨爣宸紓缁欏嚭 p 鍊间笌缁撹锛屾棤闇€ numpy/scipy銆?+""" + +from __future__ import annotations + +import math +from statistics import mean as _mean + + +def mean(xs) -> float: +    return _mean(xs) if xs else float("nan") + + +def variance(xs, *, ddof: int = 1) -> float: +    n = len(xs) +    if n - ddof <= 0: +        return float("nan") +    m = _mean(xs) +    return sum((v - m) ** 2 for v in xs) / (n - ddof) + + +def stddev(xs, *, ddof: int = 1) -> float: +    v = variance(xs, ddof=ddof) +    return math.sqrt(v) if math.isfinite(v) else float("nan") + + +def _betainc(x: float, a: float, b: float, *, max_iter: int = 300) -> float: +    """Regularized incomplete beta function I_x(a, b)銆?"" +    if x <= 0.0: +        return 0.0 +    if x >= 1.0: +        return 1.0 +    bt = math.exp( +        math.lgamma(a + b) - math.lgamma(a) - math.lgamma(b) +        + a * math.log(x) + b * math.log1p(-x) +    ) +    if x < (a + 1.0) / (a + b + 2.0): +        return bt * _beta_cf(a, b, x, max_iter=max_iter) / a +    return 1.0 - bt * _beta_cf(b, a, 1.0 - x, max_iter=max_iter) / b + + +def _beta_cf(a: float, b: float, x: float, *, max_iter: int, eps: float = 3e-14) -> float: +    """Lentz 杩炲垎鏁版暟鍊煎疄鐜般€?"" +    qab, qap, qam = a + b, a + 1.0, a - 1.0 +    c, d = 1.0, 1.0 - qab * x / qap +    if abs(d) < 1e-30: +        d = 1e-30 +    d = 1.0 / d +    h = d +    for m in range(1, max_iter + 1): +        m2 = 2 * m +        aa = m * (b - m) * x / ((qam + m2) * (a + m2)) +        d = 1.0 + aa * d +        if abs(d) < 1e-30: +            d = 1e-30 +        c = 1.0 + aa / c +        if abs(c) < 1e-30: +            c = 1e-30 +        d = 1.0 / d +        h *= d * c +        aa = -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2)) +        d = 1.0 + aa * d +        if abs(d) < 1e-30: +            d = 1e-30 +        c = 1.0 + aa / c +        if abs(c) < 1e-30: +            c = 1e-30 +        d = 1.0 / d +        delta = d * c +        h *= delta +        if abs(delta - 1.0) < eps: +            break +    return h + + +def _normal_cdf(z: float) -> float: +    return 0.5 * math.erfc(-z / math.sqrt(2.0)) + + +def _normal_sf(z: float) -> float: +    return 0.5 * math.erfc(z / math.sqrt(2.0)) + + +def welch_t(x: list[float], y: list[float]) -> dict: +    """Welch 涓ゆ牱鏈?t 妫€楠岋紙涓嶅亣璁剧瓑鏂瑰樊锛夈€?+ +    杩斿洖 {n1,n2,mean1,mean2,var1,var2,t,df,p,different}锛?+    p 涓哄弻灏撅紝different 琛ㄧず p<0.05銆?+    """ +    n1, n2 = len(x), len(y) +    if n1 < 2 or n2 < 2: +        return {"n1": n1, "n2": n2, "p": float("nan"), "different": False, +                "reason": "姣忕粍鑷冲皯闇€瑕?2 涓牱鏈?} +    m1, m2 = mean(x), mean(y) +    v1, v2 = variance(x), variance(y) +    if v1 <= 0 or v2 <= 0: +        t = float("nan") +        df = 0.0 +    else: +        se2 = v1 / n1 + v2 / n2 +        t = (m1 - m2) / math.sqrt(se2) +        num = se2 * se2 +        den = ((v1 / n1) ** 2) / (n1 - 1) + ((v2 / n2) ** 2) / (n2 - 1) +        df = num / den if den > 0 else float("nan") +    if not (df > 0 and math.isfinite(t)): +        p = float("nan") +    else: +        x_ = df / (df + t * t) +        p = _betainc(x_, df / 2.0, 0.5) +    return { +        "n1": n1, "n2": n2, "mean1": m1, "mean2": m2, +        "std1": stddev(x), "std2": stddev(y), +        "var1": v1, "var2": v2, "t": t, "df": df, +        "p": p, "different": bool(math.isfinite(p) and p < 0.05), +    } + + +def _ranks(values: list[float]) -> list[float]: +    idx = sorted(range(len(values)), key=lambda i: values[i]) +    ranks = [0.0] * len(values) +    i = 0 +    n = len(values) +    while i < n: +        j = i +        while j + 1 < n and values[idx[j + 1]] == values[idx[i]]: +            j += 1 +        avg = (i + j) / 2.0 + 1.0 +        for k in range(i, j + 1): +            ranks[idx[k]] = avg +        i = j + 1 +    return ranks + + +def _tie_factor(values: list[float]) -> float: +    seen: list[tuple[int, float]] = []  # (count at this value) +    from collections import Counter + +    cnt = Counter(values) +    total = 0 +    for v, c in cnt.items(): +        if c > 1: +            total += c ** 3 - c +    return total + + +def mann_whitney_u(x: list[float], y: list[float]) -> dict: +    """Mann-Whitney U 妫€楠岋紙姝ｆ€佽繎浼?+ 鐗瑰鐞嗗钩灞€锛夈€?+ +    杩斿洖 {n1,n2,u1,u2,z,p,different,better}锛宲 鍙屽熬銆俠etter 琛ㄧず x 涓ユ牸浼樹簬 y +    涓旀樉钁楋紙鎸夌З鏈熸湜锛夈€?+    """ +    n1, n2 = len(x), len(y) +    if n1 < 2 or n2 < 2: +        return {"n1": n1, "n2": n2, "p": float("nan"), "different": False, +                "reason": "姣忕粍鑷冲皯闇€瑕?2 涓牱鏈?} +    pooled = x + y +    ranks = _ranks(pooled) +    r1 = sum(ranks[:n1]) +    u1 = r1 - n1 * (n1 + 1) / 2.0 +    u2 = n1 * n2 - u1 +    mu = n1 * n2 / 2.0 +    n = n1 + n2 +    tie = _tie_factor(pooled) +    var = (n1 * n2 / 12.0) * ((n + 1.0) - tie / (n * (n - 1.0))) +    if var <= 0: +        return {"n1": n1, "n2": n2, "u1": u1, "u2": u2, +                "p": float("nan"), "different": False, "better": None, +                "reason": "鏍锋湰鏂瑰樊濂囧紓锛堝叏骞冲眬锛?} +    sd = math.sqrt(var) +    z = (u1 - mu) / sd +    if z > 0: +        zc = (u1 - mu - 0.5) / sd +    elif z < 0: +        zc = (u1 - mu + 0.5) / sd +    else: +        zc = 0.0 +    p = 2.0 * _normal_sf(abs(zc)) +    if p > 1.0: +        p = 1.0 +    better = None +    if math.isfinite(p) and p < 0.05: +        m1 = mean(x) +        m2 = mean(y) +        if m1 != m2: +            better = "x" if m1 > m2 else "y" +    return { +        "n1": n1, "n2": n2, "u1": u1, "u2": u2, +        "z": z, "p": p, "different": bool(math.isfinite(p) and p < 0.05), +        "better": better, +    } \ No newline at end of file diff --git a/clawsgo_self/research/survey.py b/clawsgo_self/research/survey.py new file mode 100644 index 0000000..547f068 --- /dev/null +++ b/clawsgo_self/research/survey.py @@ -0,0 +1,180 @@ +"""鏂囩尞缁艰堪锛